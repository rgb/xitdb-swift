@Tutorial(time: 15) {
    @Intro(title: "An index of your own") {
        Keep records in a hash map, and an index of them in a sorted map: page through it, search it by prefix, keep it in
        step with the records, and add another.

        XitDB has no `CREATE INDEX`. An index is another data structure, written in the same transaction as the data. You
        should have done <doc:YourFirstDatabase>.
    }

    @Section(title: "Store the records and an index") {
        @ContentAndMedia {
            The records are books, looked up by their ID in a ``HashMap``. They have to be listed by title, which a hash
            map cannot do, so a ``SortedMap`` from the title to the ID goes beside it. <doc:SortingAndPaginating> covers
            the same ground at more length.
        }

        @Steps {
            @Step {
                Some books to store, in no particular order.

                @Code(name: "main.swift", file: "own-index-01.swift")
            }

            @Step {
                A database with a history, as in the earlier tutorials.

                @Code(name: "main.swift", file: "own-index-02.swift")
            }

            @Step {
                One transaction writes the records and the index together, so that no moment has one without the other.
                A title is a key of any length, and the sorted map takes its bytes as they are, without a hash.

                @Code(name: "main.swift", file: "own-index-03.swift")
            }
        }
    }

    @Section(title: "Page through it") {
        @ContentAndMedia {
            A page is an offset and a size. The tree counts what is beneath each branch, so it goes to any position in
            logarithmic time, without walking over the entries before it.
        }

        @Steps {
            @Step {
                Read the two collections from the latest moment.

                @Code(name: "main.swift", file: "own-index-04.swift")
            }

            @Step {
                Write a function that gives one page of an index. ``SortedMap/iterator(fromIndex:)`` starts at a position, and you stop
                when the page is full. The value of each entry is the book's ID, so the IDs come back in the order of the
                titles: Dracula, Emma, Middlemarch, Moby-Dick.

                @Code(name: "main.swift", file: "own-index-05.swift")
            }

            @Step {
                Look a record up by its ID, which is what the index gave you.

                @Code(name: "main.swift", file: "own-index-06.swift")
            }
        }
    }

    @Section(title: "Search it") {
        @ContentAndMedia {
            An index in order can do what a list never can: seek to a key.
        }

        @Steps {
            @Step {
                Search by prefix. ``SortedMap/iterator(fromKey:)-(Sequence<UInt8>)`` starts at the first key that is not below the one you give, whether
                or not it exists. You stop at the first key that no longer has the prefix.

                @Code(name: "main.swift", file: "own-index-07.swift")
            }

            @Step {
                Ask where a key is. ``SortedMap/rank(of:)-(Sequence<UInt8>)`` is the number of keys below it, and it works for a key that is not there,
                which gives you the page a search result would be on.

                @Code(name: "main.swift", file: "own-index-08.swift")
            }
        }
    }

    @Section(title: "Add a second order") {
        @ContentAndMedia {
            Keys sort as bytes. To sort by a number, encode it so that its bytes sort the way the numbers do. An index can
            be added at any time, in a later transaction.
        }

        @Steps {
            @Step {
                Index the books by year. A number in big-endian order sorts as a number, and the ID after it keeps two books
                of one year apart, since two entries with one key would be one entry.

                @Code(name: "main.swift", file: "own-index-09.swift")
            }

            @Step {
                The same function reads the new index, since a page of IDs is a page of IDs.

                @Code(name: "main.swift", file: "own-index-10.swift")
            }
        }
    }

    @Section(title: "Keep it in step") {
        @ContentAndMedia {
            Nothing keeps an index up to date but your own code. The transaction is what makes that safe.
        }

        @Steps {
            @Step {
                Correct a title. The record changes, and the index entry moves: a key cannot be changed, so the old one is
                removed and the new one put. Both happen in one transaction.

                @Code(name: "main.swift", file: "own-index-11.swift")
            }

            @Step {
                Read the index in the new moment, which has the new title and not the old. The `byTitle` you made earlier is
                a view of the earlier moment, and it has the old title still.

                @Code(name: "main.swift", file: "own-index-12.swift")
            }
        }
    }
}
