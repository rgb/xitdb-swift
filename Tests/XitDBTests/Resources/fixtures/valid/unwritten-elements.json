{
  "format": "xitdb-script/1",
  "description": "An element appended and never written. Since 89da8e7 an array list's append writes the new slot as none with full set, as a linked array list's always has, so the element is the same as one set to nothing: it counts, a lookup gives that slot, the iterator gives it, and a typed read of it raises UnexpectedTag. After a slice, the iterator gives as many elements as the list has, starting with that one, and so it stops at the end, where on a version 1 file with a truly empty slot it doesn't (tests/port-differs/iterator-past-slice).",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "0011223344556677",
  "ops": [
    { "op": "write_path", "on": "root", "path": [{ "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "array_list_init", "array_list_append"], "note": "never written" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "array_list_init", "array_list_append", { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "array_list_init", "array_list_append", { "write": { "uint": 2 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "array_list_init", "array_list_append", { "write": { "uint": 3 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "set_to_nothing" } } }, "array_list_init", "array_list_append", { "write": { "slot": null } }], "note": "the same slot, written" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "linked" } } }, "linked_array_list_init", "linked_array_list_append"], "note": "never written" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "linked" } } }, "linked_array_list_init", "linked_array_list_append", { "write": { "uint": 1 } }] }
    ] } }] },

    { "op": "read_path", "on": "root", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }], "as": "list" },
    { "op": "count", "on": "list", "expect": 4 },
    { "op": "read_path_slot", "on": "list", "path": [{ "array_list_get": 0 }], "expect": { "tag": "none", "value": 0, "full": true } },
    { "op": "read_path", "on": "list", "path": [{ "array_list_get": 0 }], "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect_error": "UnexpectedTag" },
    { "op": "read_path_slot", "on": "root", "path": [{ "hash_map_get": { "value": { "sha1": "set_to_nothing" } } }, { "array_list_get": 0 }], "expect": { "tag": "none", "value": 0, "full": true } },
    { "op": "iterator", "on": "list", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "slot", "on": "e", "expect": { "tag": "none", "full": true } },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 1 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 2 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 3 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "read_path", "on": "root", "path": [{ "hash_map_get": { "value": { "sha1": "linked" } } }], "as": "linked" },
    { "op": "count", "on": "linked", "expect": 2 },
    { "op": "read_path_slot", "on": "linked", "path": [{ "linked_array_list_get": 0 }], "expect": { "tag": "none", "full": true } },
    { "op": "iterator", "on": "linked", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "slot", "on": "e", "expect": { "tag": "none", "full": true } },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 1 },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "write_path", "on": "root", "path": [{ "hash_map_init": {} }, { "hash_map_get": { "value": { "sha1": "list" } } }, "array_list_init", { "array_list_slice": { "size": 2 } }], "note": "what's past the new end stays in the list's blocks" },
    { "op": "read_path", "on": "root", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }], "as": "list" },
    { "op": "count", "on": "list", "expect": 2 },
    { "op": "read_path", "on": "list", "path": [{ "array_list_get": 2 }], "expect_null": true },
    { "op": "iterator", "on": "list", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "slot", "on": "e", "expect": { "tag": "none", "full": true } },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 1 },
    { "op": "next", "on": "it", "expect_null": true, "note": "the end of the list" },
    { "op": "iterator", "on": "list", "from_index": 1, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 1 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "write_path", "on": "root", "path": [{ "hash_map_init": {} }, { "hash_map_get": { "value": { "sha1": "list" } } }, "array_list_init", "array_list_append"], "note": "an append after the slice writes over what was past the end, with the same none slot marked full" },
    { "op": "read_path_slot", "on": "root", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, { "array_list_get": 2 }], "expect": { "tag": "none", "value": 0, "full": true } }
  ]
}
