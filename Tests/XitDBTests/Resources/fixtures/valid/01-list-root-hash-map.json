{
  "format": "xitdb-script/1",
  "description": "A list-rooted transaction puts one value of each kind in a hash map. A second moment changes one value and leaves the first moment readable.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "c0f0000000000001",
  "ops": [
    { "op": "read_path_slot", "on": "root", "path": [{ "array_list_get": -1 }], "as": "last", "expect_null": true,
      "note": "the database is new, so there is no last moment yet" },
    { "op": "write_path", "on": "root", "path": [
      "array_list_init",
      "array_list_append",
      { "write": { "slot": { "var": "last" } } },
      { "hash_map_init": {} },
      { "ctx": { "as": "moment", "ops": [
        { "op": "write_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "short" } } }, { "write": { "bytes": "foo" } }] },
        { "op": "write_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "long" } } }, { "write": { "bytes": "longer than eight bytes" } }] },
        { "op": "write_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "short-tagged" } } }, { "write": { "bytes_object": { "value": "foo", "format_tag": "st" } } }] },
        { "op": "write_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "long-tagged" } } }, { "write": { "bytes_object": { "value": "seven b", "format_tag": "lt" } } }] },
        { "op": "write_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "zero-byte" } } }, { "write": { "bytes": { "hex": "610062" } } }] },
        { "op": "write_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "uint" } } }, { "write": { "uint": 18446744073709551615 } }] },
        { "op": "write_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "int" } } }, { "write": { "int": -9223372036854775808 } }] },
        { "op": "write_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "float" } } }, { "write": { "float": "400921fb54442d18" } }] },
        { "op": "write_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "nan" } } }, { "write": { "float": "7ff4000000000001" } }] },
        { "op": "write_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "nothing" } } }, { "write": { "slot": null } }] },
        { "op": "write_path", "on": "moment", "path": [{ "hash_map_get": { "key": { "sha1": "short" } } }, { "write": { "bytes": "short" } }],
          "note": "the same entry can hold its key too" }
      ] } }
    ] },

    { "op": "read_path", "on": "root", "path": [{ "array_list_get": -1 }], "as": "m0" },
    { "op": "count", "on": "root", "expect": 1 },
    { "op": "read_path", "on": "m0", "path": [{ "hash_map_get": { "value": { "sha1": "short" } } }], "as": "c" },
    { "op": "read_bytes", "on": "c", "expect": "foo", "expect_format_tag": null },
    { "op": "slot", "on": "c", "expect": { "tag": "short_bytes", "full": false } },
    { "op": "read_path", "on": "m0", "path": [{ "hash_map_get": { "value": { "sha1": "long" } } }], "as": "c" },
    { "op": "read_bytes", "on": "c", "expect": "longer than eight bytes", "expect_format_tag": null },
    { "op": "slot", "on": "c", "expect": { "tag": "bytes", "full": false } },
    { "op": "read_path", "on": "m0", "path": [{ "hash_map_get": { "value": { "sha1": "short-tagged" } } }], "as": "c" },
    { "op": "read_bytes", "on": "c", "expect": "foo", "expect_format_tag": "st" },
    { "op": "slot", "on": "c", "expect": { "tag": "short_bytes", "full": true } },
    { "op": "read_path", "on": "m0", "path": [{ "hash_map_get": { "value": { "sha1": "long-tagged" } } }], "as": "c" },
    { "op": "read_bytes", "on": "c", "expect": "seven b", "expect_format_tag": "lt" },
    { "op": "slot", "on": "c", "expect": { "tag": "bytes", "full": true },
      "note": "seven bytes would fit in a slot, but not with a format tag" },
    { "op": "read_path", "on": "m0", "path": [{ "hash_map_get": { "value": { "sha1": "zero-byte" } } }], "as": "c" },
    { "op": "read_bytes", "on": "c", "expect": { "hex": "610062" } },
    { "op": "slot", "on": "c", "expect": { "tag": "bytes" },
      "note": "three bytes would fit in a slot, but not with a zero byte in them" },
    { "op": "count", "on": "c", "expect": 3 },
    { "op": "read_path", "on": "m0", "path": [{ "hash_map_get": { "value": { "sha1": "uint" } } }], "as": "c" },
    { "op": "read_uint", "on": "c", "expect": 18446744073709551615 },
    { "op": "read_int", "on": "c", "expect_error": "UnexpectedTag" },
    { "op": "read_path", "on": "m0", "path": [{ "hash_map_get": { "value": { "sha1": "int" } } }], "as": "c" },
    { "op": "read_int", "on": "c", "expect": -9223372036854775808 },
    { "op": "read_path", "on": "m0", "path": [{ "hash_map_get": { "value": { "sha1": "float" } } }], "as": "c" },
    { "op": "read_float", "on": "c", "expect": "400921fb54442d18" },
    { "op": "read_path", "on": "m0", "path": [{ "hash_map_get": { "value": { "sha1": "nan" } } }], "as": "c" },
    { "op": "read_float", "on": "c", "expect": "7ff4000000000001" },
    { "op": "read_path_slot", "on": "m0", "path": [{ "hash_map_get": { "value": { "sha1": "nothing" } } }], "expect_null": false, "expect": { "tag": "none", "full": true } },
    { "op": "read_path_slot", "on": "m0", "path": [{ "hash_map_get": { "value": { "sha1": "absent" } } }], "expect_null": true },
    { "op": "read_path", "on": "m0", "path": [{ "hash_map_get": { "kv_pair": { "sha1": "short" } } }], "as": "pair" },
    { "op": "read_key_value_pair", "on": "pair", "key_as": "k", "value_as": "v", "expect_hash": { "sha1": "short" } },
    { "op": "read_bytes", "on": "k", "expect": "short" },
    { "op": "read_bytes", "on": "v", "expect": "foo" },

    { "op": "read_path_slot", "on": "root", "path": [{ "array_list_get": -1 }], "as": "last" },
    { "op": "write_path", "on": "root", "path": [
      "array_list_init",
      "array_list_append",
      { "write": { "slot": { "var": "last" } } },
      { "hash_map_init": {} },
      { "hash_map_get": { "value": { "sha1": "short" } } },
      { "write": { "bytes": "bar" } }
    ], "note": "no callback this time: the whole transaction is one path" },

    { "op": "count", "on": "root", "expect": 2 },
    { "op": "read_path", "on": "root", "path": [{ "array_list_get": -1 }, { "hash_map_get": { "value": { "sha1": "short" } } }], "as": "c" },
    { "op": "read_bytes", "on": "c", "expect": "bar" },
    { "op": "read_path", "on": "root", "path": [{ "array_list_get": 0 }, { "hash_map_get": { "value": { "sha1": "short" } } }], "as": "c" },
    { "op": "read_bytes", "on": "c", "expect": "foo" },
    { "op": "read_path", "on": "m0", "path": [{ "hash_map_get": { "value": { "sha1": "short" } } }], "as": "c" },
    { "op": "read_bytes", "on": "c", "expect": "foo", "note": "a read-only cursor kept from before the commit still sees the first moment" }
  ]
}
