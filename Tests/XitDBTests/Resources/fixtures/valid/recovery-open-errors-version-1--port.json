{
  "format": "xitdb-script/1",
  "description": "recovery-open-errors-version-1 with what the port does, as recovery-open-errors--port does for version 2. A root header that can't be trusted raises UntrustedRootHeader, and recover ends the file at the last trailer that verifies and writes its end as the committed size at 29, leaving the copy of the root slot at 20 to 28 as the last commit at 6b93af1 wrote it (D31 item 1), and the file version 1.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "c0f0000000000001",
  "ops": [
    {"op": "close"},
    {"op": "raw_load", "input": "v1-history", "note": "two commits, ending at 839 and 1215, the last trailer at 1190"},
    {"op": "raw_write", "offset": 0, "bytes": {"hex": "7a"}, "note": "the magic number"},
    {"op": "reopen", "expect_error": "InvalidDatabase"},
    {"op": "raw_write", "offset": 0, "bytes": {"hex": "78"}},
    {"op": "raw_write", "offset": 4, "bytes": {"hex": "0000"}, "note": "a version that's neither 1 nor 2"},
    {"op": "reopen", "expect_error": "InvalidVersion"},
    {"op": "raw_write", "offset": 4, "bytes": {"hex": "0003"}},
    {"op": "reopen", "expect_error": "InvalidVersion"},
    {"op": "raw_write", "offset": 4, "bytes": {"hex": "0001"}},
    {"op": "raw_write", "offset": 6, "bytes": {"hex": "0008"}, "note": "the hash size"},
    {"op": "reopen", "expect_error": "InvalidHashSize"},
    {"op": "raw_write", "offset": 6, "bytes": {"hex": "0014"}},
    {"op": "raw_write", "offset": 29, "bytes": {"hex": "000000000000000a"}, "note": "a committed size, at 29 in version 1, smaller than a new database"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "raw_write", "offset": 29, "bytes": {"hex": "00000000000004c0"}, "note": "one past the end of the file"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "raw_write", "offset": 29, "bytes": {"hex": "00000000000004be"}, "note": "one that doesn't end at a trailer"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "raw_write", "offset": 29, "bytes": {"hex": "00000000000004bf"}},
    {"op": "raw_write", "offset": 1190, "bytes": {"hex": "ff0000000000000350"}, "note": "a changed root slot in the last trailer, whose checksum then fails"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "raw_write", "offset": 1190, "bytes": {"hex": "020000000000000350"}},
    {"op": "reopen", "hash_size": 8, "expect_error": "InvalidHashSize", "note": "a file that's fine, opened with another hash size"},
    {"op": "reopen", "note": "and as it is"},
    {"op": "count", "on": "root", "expect": 2},
    {"op": "read_path", "on": "root", "path": [{"array_list_get": -1}, {"hash_map_get": {"value": {"sha1": "short"}}}], "as": "c"},
    {"op": "read_bytes", "on": "c", "expect": "bar"},
    {"op": "close"},
    {"op": "raw_write", "offset": 0, "bytes": {"hex": "7a"}, "note": "a bad magic number can't be recovered from"},
    {"op": "recover", "expect_error": "InvalidDatabase"},
    {"op": "raw_write", "offset": 0, "bytes": {"hex": "78"}},
    {"op": "raw_write", "offset": 29, "bytes": {"hex": "00000000000004c0"}, "note": "a committed size past the end, and the last trailer that verifies is the last commit"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "recover", "note": "which writes the size at 29, and leaves the copy of the root slot at 20 to 28 as it is"},
    {"op": "committed_size", "expect": 1215},
    {"op": "close"},
    {"op": "raw_write", "offset": 29, "bytes": {"hex": "000000000000000a"}, "note": "a committed size smaller than a new database, with what a crash left, which recovering drops"},
    {"op": "raw_append", "bytes": "what a crash left"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "recover"},
    {"op": "committed_size", "expect": 1215},
    {"op": "close"},
    {"op": "raw_write", "offset": 1190, "bytes": {"hex": "ff0000000000000350"}, "note": "a changed root slot in the last trailer, so the last commit is lost"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "recover"},
    {"op": "committed_size", "expect": 839},
    {"op": "count", "on": "root", "expect": 1},
    {"op": "read_path_slot", "on": "root", "path": [{"array_list_get": -1}], "as": "last"},
    {"op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", {"write": {"slot": {"var": "last"}}}, {"hash_map_init": {}}, {"hash_map_get": {"value": {"sha1": "b"}}}, {"write": {"uint": 2}}], "note": "and it goes on from there, as version 1"},
    {"op": "count", "on": "root", "expect": 2}
  ]
}
