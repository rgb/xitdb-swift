{
  "format": "xitdb-script/1",
  "description": "Runs what the five scripts in scripts/ don't, of everything in SCRIPT-FORMAT.md that needs only array lists and hash maps. every-construct-linked and every-construct-sorted do the same for the other two collections, which arrive at later milestones.",
  "hash_size": 20,
  "hash_id": { "hex": "73686131" },
  "file_id": "ffffffffffffffff",
  "ops": [
    { "op": "write_path", "on": "root", "path": [
      "array_list_init",
      "array_list_append",
      { "hash_map_init": {} },
      { "ctx": { "as": "m", "ops": [

        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "array" } } }, "array_list_init"], "as": "a" },
        { "op": "write_path", "on": "a", "path": ["array_list_append", { "write": { "uint": 1 } }] },
        { "op": "write_path", "on": "a", "path": ["array_list_append", { "write": { "uint": 2 } }] },
        { "op": "write_path", "on": "a", "path": ["array_list_append", { "write": { "uint": 3 } }] },
        { "op": "write_path", "on": "a", "path": [{ "array_list_get": 1 }, { "write": { "uint": 20 } }] },
        { "op": "write_path", "on": "a", "path": [{ "array_list_slice": { "size": 2 } }] },
        { "op": "count", "on": "a", "expect": 2 },
        { "op": "write_path", "on": "a", "path": [{ "array_list_get": 2 }], "expect_error": "KeyNotFound" },
        { "op": "write_path", "on": "a", "path": [{ "array_list_slice": { "size": 18446744073709551615 } }], "expect_error": "KeyNotFound" },
        { "op": "write_path", "on": "a", "path": ["array_list_append"], "as": "a2" },
        { "op": "slot", "on": "a2", "expect": { "tag": "none", "full": false }, "note": "append clears what the slice left in the slot" },
        { "op": "write", "on": "a2", "data": { "uint": 30 } },

        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "set" } } }, { "hash_map_init": { "set": true } }], "as": "hs" },
        { "op": "write_path", "on": "hs", "path": [{ "hash_map_get": { "key": { "hex": "0000000000000000000000000000000000000001" } } }, { "write": { "bytes": "one" } }] },
        { "op": "write_path", "on": "hs", "path": [{ "hash_map_get": { "key": { "hex": "0000000000000000000000000000000000000011" } } }, { "write": { "bytes": "seventeen" } }],
          "note": "shares its lowest nibble with the previous key, so the trie grows a level" },
        { "op": "read_path", "on": "hs", "path": [{ "hash_map_get": { "key": { "hex": "0000000000000000000000000000000000000011" } } }], "as": "c" },
        { "op": "read_bytes", "on": "c", "expect": "seventeen" },

        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "counted-map" } } }, { "hash_map_init": { "counted": true } }], "as": "cm" },
        { "op": "write_path", "on": "cm", "path": [{ "hash_map_get": { "value": { "sha1": "x" } } }, { "write": { "uint": 1 } }] },
        { "op": "write_path", "on": "cm", "path": [{ "hash_map_get": { "value": { "sha1": "y" } } }, { "write": { "uint": 2 } }] },
        { "op": "write_path", "on": "cm", "path": [{ "hash_map_get": { "value": { "sha1": "y" } } }, { "write": { "uint": 3 } }] },
        { "op": "count", "on": "cm", "expect": 2 },
        { "op": "write_path", "on": "cm", "path": [{ "hash_map_remove": { "sha1": "x" } }] },
        { "op": "count", "on": "cm", "expect": 1 },
        { "op": "write_path", "on": "cm", "path": [{ "hash_map_remove": { "sha1": "x" } }], "expect_error": "KeyNotFound" },
        { "op": "count", "on": "cm", "expect": 1 },

        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "counted-set" } } }, { "hash_map_init": { "counted": true, "set": true } }], "as": "cs" },
        { "op": "write_path", "on": "cs", "path": [{ "hash_map_get": { "key": { "sha1": "x" } } }, { "write": { "bytes": "x" } }] },
        { "op": "count", "on": "cs", "expect": 1 },
        { "op": "write_path", "on": "cs", "path": [{ "hash_map_init": { "set": true } }], "expect_error": "UnexpectedTag", "note": "counted and uncounted can't be reinterpreted as each other" },

        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "kv" } } }, { "hash_map_init": {} }], "as": "kvm" },
        { "op": "write_path", "on": "kvm", "path": [{ "hash_map_get": { "kv_pair": { "sha1": "x" } } }], "as": "pair" },
        { "op": "slot", "on": "pair", "expect": { "tag": "kv_pair" } },
        { "op": "read_key_value_pair", "on": "pair", "key_as": "k", "value_as": "v" },
        { "op": "write", "on": "k", "data": { "bytes": "x" }, "note": "cursors from a read-write pair can write" },
        { "op": "write", "on": "v", "data": { "uint": 11 } },
        { "op": "read_path", "on": "kvm", "path": [{ "hash_map_get": { "value": { "sha1": "x" } } }], "as": "c" },
        { "op": "read_uint", "on": "c", "expect": 11 },

        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "stream" } } }], "as": "w" },
        { "op": "writer", "on": "w", "steps": [
          { "write": "x" }, { "write": "x" }, { "write": "x" },
          { "seek": 0 }, { "write": "b" },
          { "seek": 2 }, { "write": "z" },
          { "seek": 1 }, { "write": "a" }
        ], "note": "as in test.zig" },
        { "op": "read_bytes", "on": "w", "expect": "baz", "expect_format_tag": null },
        { "op": "slot", "on": "w", "expect": { "tag": "bytes", "full": false }, "note": "streamed bytes are never short, however few there are" },
        { "op": "writer", "on": "w", "format_tag": "hi", "steps": [{ "write": "hello" }] },
        { "op": "read_bytes", "on": "w", "expect": "hello", "expect_format_tag": "hi" },
        { "op": "slot", "on": "w", "expect": { "tag": "bytes", "full": true } },
        { "op": "writer", "on": "w", "format_tag": { "hex": "00ff" }, "steps": [], "note": "no bytes: a length of zero and a format tag" },
        { "op": "read_bytes", "on": "w", "expect": "", "expect_format_tag": { "hex": "00ff" } },
        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "gap" } } }], "as": "g" },
        { "op": "writer", "on": "g", "steps": [{ "write": "ab" }, { "seek": 4 }, { "write": "c" }],
          "note": "seeking past the end leaves a gap of zeros. it is read after the commit, because before the commit a read in the gap depends on the storage kind (see SCRIPT-FORMAT.md)" },
        { "op": "count", "on": "g", "expect": 5 },

        { "op": "write_path", "on": "w", "path": [], "as": "w_again" },
        { "op": "writer", "on": "w_again", "steps": [{ "write": { "hex": "6869" } }, { "write": "!" }] },
        { "op": "read_bytes", "on": "w_again", "expect": "hi!" },

        { "op": "slot", "on": "kvm", "expect": { "tag": "hash_map" } },
        { "op": "slot", "on": "cm", "expect": { "tag": "counted_hash_map" } },
        { "op": "slot", "on": "cs", "expect": { "tag": "counted_hash_set" } },

        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "forms" } } }, { "hash_map_init": { "counted": false, "set": false } }], "as": "fm" },
        { "op": "write_path", "on": "fm", "path": [{ "hash_map_get": { "value": { "sha1": { "hex": "666f6f" } } } }, { "write": { "bytes": { "hex": "" } } }], "as": "c", "note": "the same key as {sha1: foo}, and an empty value" },
        { "op": "read_bytes", "on": "c", "expect": { "hex": "" } },
        { "op": "read_path", "on": "fm", "path": [{ "hash_map_get": { "kv_pair": { "hex": "0beec7b5ea3f0fdbc95d0dd47f3c5bc275da8a33" } } }], "as": "pair" },
        { "op": "read_key_value_pair", "on": "pair", "expect_hash": { "sha1": "foo" } },
        { "op": "write_path", "on": "fm", "path": [{ "hash_map_get": { "value": { "sha1": "no-tag" } } }, { "write": { "bytes_object": { "value": "no format tag" } } }], "as": "c" },
        { "op": "read_bytes", "on": "c", "expect": "no format tag", "expect_format_tag": null },
        { "op": "write_path", "on": "fm", "path": [{ "hash_map_get": { "value": { "sha1": "hex-value" } } }, { "write": { "bytes_object": { "value": { "hex": "6869" }, "format_tag": "ab" } } }], "as": "c" },
        { "op": "read_bytes", "on": "c", "expect": "hi", "expect_format_tag": { "hex": "6162" } },
        { "op": "write_path", "on": "fm", "path": [{ "hash_map_get": { "value": { "sha1": "int-max" } } }, { "write": { "int": 9223372036854775807 } }], "as": "c" },
        { "op": "read_int", "on": "c", "expect": 9223372036854775807 },
        { "op": "write_path", "on": "fm", "path": [{ "hash_map_get": { "value": { "sha1": "literal" } } }, { "write": { "slot": { "tag": "uint", "value": 5, "full": false } } }], "as": "c" },
        { "op": "read_uint", "on": "c", "expect": 5 },
        { "op": "write_path", "on": "fm", "path": [{ "hash_map_get": { "value": { "sha1": "counted" } } }, { "hash_map_init": { "counted": true, "set": false } }], "as": "c" },
        { "op": "slot", "on": "c", "expect": { "tag": "counted_hash_map" } },

        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "if-empty" } } }], "as": "e" },
        { "op": "write_if_empty", "on": "e", "data": { "uint": 1 } },
        { "op": "write_if_empty", "on": "e", "data": { "uint": 2 } },
        { "op": "read_uint", "on": "e", "expect": 1 },

        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "literal" } } }, { "write": { "slot": { "tag": "uint", "value": 77 } } }], "as": "l" },
        { "op": "read_uint", "on": "l", "expect": 77 },
        { "op": "write", "on": "l", "data": { "slot": { "tag": "none", "value": 5 } }, "note": "none always gets the full flag; the value stays" },
        { "op": "slot", "on": "l", "expect": { "tag": "none", "full": true, "value": 5 } },
        { "op": "write", "on": "l", "data": { "slot": { "tag": "short_bytes", "value": 7017280021047803904 } }, "note": "abc, left-aligned in the value" },
        { "op": "read_bytes", "on": "l", "expect": "abc" },
        { "op": "write", "on": "l", "data": { "slot": { "tag": "short_bytes", "value": 7017280021047832688, "full": true } }, "note": "the same with the format tag pp in the last two bytes" },
        { "op": "read_bytes", "on": "l", "expect": "abc", "expect_format_tag": "pp" },
        { "op": "write", "on": "l", "data": { "slot": { "tag": "int", "value": 18446744073709551615 } } },
        { "op": "read_int", "on": "l", "expect": -1 },
        { "op": "slot", "on": "l", "expect": { "tag": "int" } },
        { "op": "write", "on": "l", "data": { "slot": { "tag": "float", "value": 4614256656552045848 } } },
        { "op": "read_float", "on": "l", "expect": "400921fb54442d18" },
        { "op": "slot", "on": "l", "expect": { "tag": "float" } },
        { "op": "write", "on": "l", "data": { "uint": 1 } },
        { "op": "read_key_value_pair", "on": "l", "expect_error": "UnexpectedTag" },
        { "op": "read_float", "on": "l", "expect_error": "UnexpectedTag" },
        { "op": "read_bytes", "on": "l", "expect_error": "UnexpectedTag" },
        { "op": "count", "on": "l", "expect_error": "UnexpectedTag" },
        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "never-written" } } }], "as": "never_written" },

        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "short-edges" } } }, { "hash_map_init": {} }], "as": "se" },
        { "op": "write_path", "on": "se", "path": [{ "hash_map_get": { "value": { "sha1": "8" } } }, { "write": { "bytes": "12345678" } }], "as": "c" },
        { "op": "slot", "on": "c", "expect": { "tag": "short_bytes", "full": false } },
        { "op": "read_bytes", "on": "c", "expect": "12345678" },
        { "op": "write_path", "on": "se", "path": [{ "hash_map_get": { "value": { "sha1": "9" } } }, { "write": { "bytes": "123456789" } }], "as": "c" },
        { "op": "slot", "on": "c", "expect": { "tag": "bytes", "full": false } },
        { "op": "write_path", "on": "se", "path": [{ "hash_map_get": { "value": { "sha1": "6t" } } }, { "write": { "bytes_object": { "value": "123456", "format_tag": { "hex": "0000" } } } }], "as": "c" },
        { "op": "slot", "on": "c", "expect": { "tag": "short_bytes", "full": true } },
        { "op": "read_bytes", "on": "c", "expect": "123456", "expect_format_tag": { "hex": "0000" } },
        { "op": "write_path", "on": "se", "path": [{ "hash_map_get": { "value": { "sha1": "0" } } }, { "write": { "bytes": "" } }], "as": "c" },
        { "op": "slot", "on": "c", "expect": { "tag": "short_bytes", "value": 0, "full": false } },
        { "op": "read_bytes", "on": "c", "expect": "" },
        { "op": "write_path", "on": "se", "path": [{ "hash_map_get": { "value": { "sha1": "utf8" } } }, { "write": { "bytes": "é😀" } }], "as": "c",
          "note": "e, a combining accent and an emoji: 7 bytes, with no normalization" },
        { "op": "read_bytes", "on": "c", "expect": { "hex": "65cc81f09f9880" } },

        { "op": "read_only", "on": "se", "as": "se_read" },
        { "op": "read_path", "on": "se_read", "path": [{ "hash_map_get": { "value": { "sha1": "8" } } }], "as": "c" },
        { "op": "read_bytes", "on": "c", "expect": "12345678" },

        { "op": "read_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "absent" } } }, "array_list_init"], "expect_null": true,
          "note": "the get fails first, so this is a null result rather than WriteNotAllowed" },
        { "op": "read_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "array" } } }, "array_list_init"], "expect_error": "WriteNotAllowed" },
        { "op": "read_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "array" } } }, { "hash_map_get": { "value": { "sha1": "x" } } }], "expect_error": "UnexpectedTag",
          "note": "only KeyNotFound becomes a null result" }
      ] } }
    ] },
    { "op": "read_bytes", "on": "g", "expect": { "hex": "6162000063" }, "note": "a cursor kept from the transaction can still read" },
    { "op": "write_if_empty", "on": "never_written", "data": { "uint": 1 }, "expect_error": "ExpectedTxStart" },
    { "op": "read_path", "on": "root", "path": [{ "array_list_get": -1 }, { "hash_map_get": { "value": { "sha1": "array" } } }], "as": "c" },
    { "op": "count", "on": "c", "expect": 3 },
    { "op": "read_path", "on": "root", "path": [{ "array_list_get": -1 }, { "hash_map_get": { "value": { "sha1": "array" } } }, { "array_list_get": -1 }], "as": "c" },
    { "op": "read_uint", "on": "c", "expect": 30 }
  ]
}
