{
  "format": "xitdb-script/1",
  "description": "What test.zig's compaction test does: three moments with every kind of value and collection, and references that go around in circles, compacted into one moment. The target is the expected file. Then it's read, written to and reopened.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "0011223344556677",
  "ops": [
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "key1" } } }, { "write": { "bytes": "value1" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "key2" } } }, { "write": { "uint": 100 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "only_in_the_first" } } }, { "write": { "bytes": "a long value that no later moment has" } }] }
    ] } }] },

    { "op": "read_path_slot", "on": "root", "path": [{ "array_list_get": -1 }], "as": "last" },
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "write": { "slot": { "var": "last" } } }, { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "key1" } } }, { "write": { "bytes": "updated_value1" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "key2" } } }, { "write": { "uint": 200 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "key3" } } }, { "write": { "int": -42 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "key4" } } }, { "write": { "float": "40091eb851eb851f" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "short" } } }, { "write": { "bytes": "hi" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "cleared" } } }, { "write": { "slot": null } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "tagged" } } }, { "write": { "bytes_object": { "value": "this is a long tagged string!!", "format_tag": "bi" } } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "tagged_short" } } }, { "write": { "bytes_object": { "value": "abc", "format_tag": "xy" } } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "empty_record" } } }], "as": "empty_record" },
      { "op": "writer", "on": "empty_record", "steps": [] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "key": { "sha1": "key5" } } }, { "write": { "bytes": "a long key that's written with a value" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "key5" } } }, { "write": { "uint": 5 } }] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "fruits" } } }, "array_list_init", "array_list_append", { "write": { "bytes": "apple" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "fruits" } } }, "array_list_init", "array_list_append", { "write": { "bytes": "banana" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "fruits" } } }, "array_list_init", "array_list_append", { "write": { "bytes": "a cherry too long for a slot" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "fruits" } } }, "array_list_init", "array_list_append"], "note": "never written" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "empty_list" } } }, "array_list_init"] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "todos" } } }, "linked_array_list_init", "linked_array_list_append", { "write": { "bytes": "task1" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "todos" } } }, "linked_array_list_init", "linked_array_list_append", { "write": { "bytes": "task3, which is too long for a slot" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "todos" } } }, "linked_array_list_init", { "linked_array_list_insert": 1 }, { "write": { "bytes": "task2" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "empty_linked" } } }, "linked_array_list_init"] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "counted" } } }, { "hash_map_init": { "counted": true } }, { "hash_map_get": { "value": { "sha1": "a" } } }, { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "counted" } } }, { "hash_map_init": { "counted": true } }, { "hash_map_get": { "key": { "sha1": "a" } } }, { "write": { "bytes": "a" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "counted" } } }, { "hash_map_init": { "counted": true } }, { "hash_map_get": { "value": { "sha1": "b" } } }, { "write": { "uint": 2 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "myset" } } }, { "hash_map_init": { "set": true } }, { "hash_map_get": { "key": { "sha1": "x" } } }, { "write": { "bytes": "x" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "myset" } } }, { "hash_map_init": { "set": true } }, { "hash_map_get": { "key": { "sha1": "y" } } }, { "write": { "bytes": "y, which is too long for a slot" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "mycset" } } }, { "hash_map_init": { "counted": true, "set": true } }, { "hash_map_get": { "key": { "sha1": "p" } } }, { "write": { "bytes": "p" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "mycset" } } }, { "hash_map_init": { "counted": true, "set": true } }, { "hash_map_get": { "key": { "sha1": "q" } } }, { "write": { "bytes": "q" } }] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sorted" } } }, { "sorted_map_init": {} }, { "sorted_map_get": { "value": "banana" } }, { "write": { "uint": 2 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sorted" } } }, { "sorted_map_init": {} }, { "sorted_map_get": { "value": "apple" } }, { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sorted" } } }, { "sorted_map_init": {} }, { "sorted_map_get": { "value": "a cherry whose key is too long for a slot" } }, { "write": { "bytes": "with a value that is too long for a slot" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sortedset" } } }, { "sorted_map_init": { "set": true } }, { "sorted_map_get": { "key": "foo" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sortedset" } } }, { "sorted_map_init": { "set": true } }, { "sorted_map_get": { "key": "a set's key that is too long for a slot" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "empty_sorted" } } }, { "sorted_map_init": {} }] }
    ] } }] },

    { "op": "read_path_slot", "on": "root", "path": [{ "array_list_get": -1 }], "as": "last" },
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "write": { "slot": { "var": "last" } } }, { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "key1" } } }, { "write": { "bytes": "final_value" } }] },

      { "op": "slot", "on": "m", "as": "moment_slot", "note": "a moment that contains itself" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "self" } } }, { "write": { "slot": { "var": "moment_slot" } } }] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "cyclic-list" } } }, "array_list_init"], "as": "cyclic" },
      { "op": "slot", "on": "cyclic", "as": "cyclic_slot" },
      { "op": "write_path", "on": "cyclic", "path": ["array_list_append", { "write": { "slot": { "var": "cyclic_slot" } } }] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "cyclic-linked" } } }, "linked_array_list_init"], "as": "cyclic" },
      { "op": "slot", "on": "cyclic", "as": "cyclic_slot" },
      { "op": "write_path", "on": "cyclic", "path": ["linked_array_list_append", { "write": { "slot": { "var": "cyclic_slot" } } }] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "cyclic-sorted" } } }, { "sorted_map_init": {} }], "as": "cyclic" },
      { "op": "slot", "on": "cyclic", "as": "cyclic_slot" },
      { "op": "write_path", "on": "cyclic", "path": [{ "sorted_map_get": { "value": "self" } }, { "write": { "slot": { "var": "cyclic_slot" } } }] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "map-a" } } }, { "hash_map_init": {} }], "as": "map_a" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "map-b" } } }, { "hash_map_init": {} }], "as": "map_b" },
      { "op": "slot", "on": "map_a", "as": "slot_a" },
      { "op": "slot", "on": "map_b", "as": "slot_b" },
      { "op": "write_path", "on": "map_a", "path": [{ "hash_map_get": { "value": { "sha1": "map-b" } } }, { "write": { "slot": { "var": "slot_b" } } }] },
      { "op": "write_path", "on": "map_b", "path": [{ "hash_map_get": { "value": { "sha1": "map-a" } } }, { "write": { "slot": { "var": "slot_a" } } }] }
    ] } }] },

    { "op": "compact", "into": "target", "file_id": "00000000000000bb", "offset_map": "memory" },
    { "op": "compact", "into": "target", "offset_map": "memory", "expect_error": "TargetNotEmpty", "note": "and it can't be done over the top of that" },
    { "op": "count", "on": "root", "expect": 3, "note": "the source is as it was, and is still the current one" },
    { "op": "use", "name": "target" },
    { "op": "count", "on": "root", "expect": 1, "note": "only the last moment" },
    { "op": "read_path", "on": "root", "path": [{ "array_list_get": 0 }], "as": "moment" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "key1" } } }], "as": "v" },
    { "op": "read_bytes", "on": "v", "expect": "final_value" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "only_in_the_first" } } }], "as": "v" },
    { "op": "read_bytes", "on": "v", "expect": "a long value that no later moment has", "note": "it's in the last moment too, as nothing removed it" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "key2" } } }], "as": "v" },
    { "op": "read_uint", "on": "v", "expect": 200 },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "key3" } } }], "as": "v" },
    { "op": "read_int", "on": "v", "expect": -42 },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "key4" } } }], "as": "v" },
    { "op": "read_float", "on": "v", "expect": "40091eb851eb851f" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "short" } } }], "as": "v" },
    { "op": "read_bytes", "on": "v", "expect": "hi" },
    { "op": "read_path_slot", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "cleared" } } }], "expect": { "tag": "none", "full": true } },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "tagged" } } }], "as": "v" },
    { "op": "read_bytes", "on": "v", "expect": "this is a long tagged string!!", "expect_format_tag": "bi" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "tagged_short" } } }], "as": "v" },
    { "op": "read_bytes", "on": "v", "expect": "abc", "expect_format_tag": "xy" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "empty_record" } } }], "as": "v" },
    { "op": "slot", "on": "v", "expect": { "tag": "bytes" } },
    { "op": "read_bytes", "on": "v", "expect": { "hex": "" } },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "kv_pair": { "sha1": "key5" } } }], "as": "pair" },
    { "op": "read_key_value_pair", "on": "pair", "key_as": "k", "value_as": "v", "expect_hash": { "sha1": "key5" } },
    { "op": "read_bytes", "on": "k", "expect": "a long key that's written with a value" },
    { "op": "read_uint", "on": "v", "expect": 5 },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "fruits" } } }], "as": "list" },
    { "op": "count", "on": "list", "expect": 4 },
    { "op": "read_path", "on": "list", "path": [{ "array_list_get": 2 }], "as": "v" },
    { "op": "read_bytes", "on": "v", "expect": "a cherry too long for a slot" },
    { "op": "read_path_slot", "on": "list", "path": [{ "array_list_get": 3 }], "expect": { "tag": "none", "full": true }, "note": "appended and never written, which since 89da8e7 is a none slot marked full, and is compacted as one" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "empty_list" } } }], "as": "list" },
    { "op": "count", "on": "list", "expect": 0 },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "todos" } } }], "as": "list" },
    { "op": "count", "on": "list", "expect": 3 },
    { "op": "read_path", "on": "list", "path": [{ "linked_array_list_get": 1 }], "as": "v" },
    { "op": "read_bytes", "on": "v", "expect": "task2" },
    { "op": "read_path", "on": "list", "path": [{ "linked_array_list_get": -1 }], "as": "v" },
    { "op": "read_bytes", "on": "v", "expect": "task3, which is too long for a slot" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "empty_linked" } } }], "as": "list" },
    { "op": "count", "on": "list", "expect": 0 },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "counted" } } }], "as": "map" },
    { "op": "count", "on": "map", "expect": 2 },
    { "op": "read_path", "on": "map", "path": [{ "hash_map_get": { "value": { "sha1": "b" } } }], "as": "v" },
    { "op": "read_uint", "on": "v", "expect": 2 },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "myset" } } }], "as": "map" },
    { "op": "read_path", "on": "map", "path": [{ "hash_map_get": { "key": { "sha1": "y" } } }], "as": "v" },
    { "op": "read_bytes", "on": "v", "expect": "y, which is too long for a slot" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "mycset" } } }], "as": "map" },
    { "op": "count", "on": "map", "expect": 2 },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "sorted" } } }], "as": "map" },
    { "op": "count", "on": "map", "expect": 3 },
    { "op": "read_path", "on": "map", "path": [{ "sorted_map_get_index": 0 }], "as": "pair" },
    { "op": "read_key_value_pair", "on": "pair", "key_as": "k", "value_as": "v" },
    { "op": "read_bytes", "on": "k", "expect": "a cherry whose key is too long for a slot" },
    { "op": "read_bytes", "on": "v", "expect": "with a value that is too long for a slot" },
    { "op": "read_path", "on": "map", "path": [{ "sorted_map_get": { "value": "banana" } }], "as": "v" },
    { "op": "read_uint", "on": "v", "expect": 2 },
    { "op": "rank", "on": "map", "key": "banana", "expect": 2 },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "sortedset" } } }], "as": "map" },
    { "op": "count", "on": "map", "expect": 2 },
    { "op": "iterator", "on": "map", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_bytes", "on": "e", "expect": "a set's key that is too long for a slot" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_bytes", "on": "e", "expect": "foo" },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "self" } } }, { "hash_map_get": { "value": { "sha1": "self" } } }, { "hash_map_get": { "value": { "sha1": "key1" } } }], "as": "v", "note": "the moment still contains itself, and not a copy" },
    { "op": "read_bytes", "on": "v", "expect": "final_value" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "cyclic-list" } } }, { "array_list_get": 0 }, { "array_list_get": 0 }, { "array_list_get": 0 }], "as": "v" },
    { "op": "slot", "on": "v", "expect": { "tag": "array_list" } },
    { "op": "count", "on": "v", "expect": 1 },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "cyclic-linked" } } }, { "linked_array_list_get": 0 }, { "linked_array_list_get": 0 }], "as": "v" },
    { "op": "slot", "on": "v", "expect": { "tag": "linked_array_list" } },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "cyclic-sorted" } } }, { "sorted_map_get": { "value": "self" } }, { "sorted_map_get": { "value": "self" } }], "as": "v" },
    { "op": "slot", "on": "v", "expect": { "tag": "sorted_map" } },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "map-a" } } }, { "hash_map_get": { "value": { "sha1": "map-b" } } }, { "hash_map_get": { "value": { "sha1": "map-a" } } }, { "hash_map_get": { "value": { "sha1": "map-b" } } }], "as": "v" },
    { "op": "slot", "on": "v", "expect": { "tag": "hash_map" } },

    { "op": "read_path_slot", "on": "root", "path": [{ "array_list_get": -1 }], "as": "last" },
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "write": { "slot": { "var": "last" } } }, { "hash_map_init": {} }, { "hash_map_get": { "value": { "sha1": "new_key" } } }, { "write": { "bytes": "new_data" } }], "note": "and it's a database like any other" },
    { "op": "count", "on": "root", "expect": 2 },
    { "op": "close" },
    { "op": "reopen" },
    { "op": "count", "on": "root", "expect": 2 },
    { "op": "read_path", "on": "root", "path": [{ "array_list_get": -1 }, { "hash_map_get": { "value": { "sha1": "new_key" } } }], "as": "v" },
    { "op": "read_bytes", "on": "v", "expect": "new_data" },
    { "op": "read_path", "on": "root", "path": [{ "array_list_get": 0 }, { "hash_map_get": { "value": { "sha1": "new_key" } } }], "expect_null": true }
  ]
}
