{
  "format": "xitdb-script/1",
  "description": "From Zig commit 185af01 on, write_if_empty goes by the slot as it is now, and this is the direction no other script has: the snapshot has something and the slot has since been emptied in place, so it writes. A remove empties the map's own slot for a key, which a kv_pair cursor points at. What goes there can't be the pair again, as run refuses to write one. A written none leaves the map working, and a uint shows that it really writes. Before 185af01, none of these write, so this fails at the first slot it checks. All the write_if_empty ops come before the checks, so that impact.sh counts them on a Zig that fails.",
  "hash_size": 8,
  "hash_id": null,
  "file_id": "c0f000000000001c",
  "ops": [
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "00000000000000a1" } } }, { "write": { "uint": 1 } }], "note": "the last digit of a hash chooses the slot in the map's first block, so these three have one each" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "00000000000000a2" } } }, { "write": { "uint": 2 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "00000000000000a3" } } }, { "write": { "uint": 3 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "0000000000000015" } } }, { "write": { "uint": 4 } }], "note": "and these three share a slot there, so they have a block of their own, by the digit before it" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "0000000000000025" } } }, { "write": { "uint": 5 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "0000000000000035" } } }, { "write": { "uint": 6 } }] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "kv_pair": { "hex": "00000000000000a1" } } }], "as": "written_none" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "kv_pair": { "hex": "00000000000000a2" } } }], "as": "written_uint" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "kv_pair": { "hex": "0000000000000015" } } }], "as": "in_its_block" },
      { "op": "slot", "on": "written_none", "expect": { "tag": "kv_pair" } },
      { "op": "slot", "on": "written_uint", "expect": { "tag": "kv_pair" } },
      { "op": "slot", "on": "in_its_block", "expect": { "tag": "kv_pair" } },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_remove": { "hex": "00000000000000a1" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_remove": { "hex": "00000000000000a2" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_remove": { "hex": "0000000000000015" } }], "note": "two keys stay in that block, so it stays, and the remove empties the slot in it" },
      { "op": "read_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "00000000000000a1" } } }], "expect_null": true },
      { "op": "read_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "00000000000000a2" } } }], "expect_null": true },
      { "op": "read_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "0000000000000015" } } }], "expect_null": true },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "00000000000000a4" } } }], "as": "written_none_since", "note": "the other direction, for what empty means: the snapshot here is empty" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "00000000000000a4" } } }, { "write": { "slot": null } }] },

      { "op": "write_if_empty", "on": "written_none", "data": { "slot": null } },
      { "op": "write_if_empty", "on": "written_uint", "data": { "uint": 9 } },
      { "op": "write_if_empty", "on": "in_its_block", "data": { "slot": null } },
      { "op": "write_if_empty", "on": "written_none_since", "data": { "uint": 9 }, "note": "a written none has full set, so it isn't empty, and this holds back" },

      { "op": "slot", "on": "written_none", "expect": { "tag": "none", "full": true } },
      { "op": "read_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "00000000000000a1" } } }], "expect_null": true, "note": "a none in the map's slot is still no key" },
      { "op": "read_uint", "on": "written_uint", "expect": 9 },
      { "op": "read_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "00000000000000a2" } } }], "expect_error": "UnexpectedTag", "note": "a map's slot holds a pair or a block, and now it holds a uint" },
      { "op": "slot", "on": "in_its_block", "expect": { "tag": "none", "full": true } },
      { "op": "read_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "0000000000000015" } } }], "expect_null": true },
      { "op": "read_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "0000000000000025" } } }], "as": "beside" },
      { "op": "read_uint", "on": "beside", "expect": 5 },
      { "op": "read_path_slot", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "00000000000000a4" } } }], "expect": { "tag": "none", "full": true } },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "hex": "00000000000000a1" } } }, { "write": { "uint": 7 } }], "note": "and a key can still go where a none was written" }
    ] } }] },

    { "op": "read_path", "on": "root", "path": [{ "array_list_get": -1 }, { "hash_map_get": { "value": { "hex": "00000000000000a1" } } }], "as": "put_back" },
    { "op": "read_uint", "on": "put_back", "expect": 7 },
    { "op": "read_path", "on": "root", "path": [{ "array_list_get": -1 }, { "hash_map_get": { "value": { "hex": "00000000000000a2" } } }], "expect_error": "UnexpectedTag" },
    { "op": "read_path", "on": "root", "path": [{ "array_list_get": -1 }, { "hash_map_get": { "value": { "hex": "00000000000000a3" } } }], "as": "untouched" },
    { "op": "read_uint", "on": "untouched", "expect": 3 },
    { "op": "read_path", "on": "root", "path": [{ "array_list_get": -1 }, { "hash_map_get": { "value": { "hex": "0000000000000035" } } }], "as": "beside_too" },
    { "op": "read_uint", "on": "beside_too", "expect": 6 }
  ]
}
