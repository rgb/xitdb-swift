{
  "format": "xitdb-script/1",
  "description": "The streaming reader: reading, seeking and where it is, on long and short values, with buffers of different sizes. What it gives doesn't depend on the buffer.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "0011223344556677",
  "ops": [
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "long" } } }, { "write": { "bytes": "abcdefghijklmnopqrstuvwxyz0123" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "short" } } }, { "write": { "bytes": "bar" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "eight" } } }, { "write": { "bytes": "12345678" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "empty_short" } } }, { "write": { "bytes": { "hex": "" } } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "zero" } } }, { "write": { "bytes": { "hex": "610062" } } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "tagged_long" } } }, { "write": { "bytes_object": { "value": "a tagged value that won't fit", "format_tag": "ab" } } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "tagged_short" } } }, { "write": { "bytes_object": { "value": "abc", "format_tag": "xy" } } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "tagged_six" } } }, { "write": { "bytes_object": { "value": "abcdef", "format_tag": "xy" } } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "empty_bytes" } } }], "as": "empty_bytes" },
      { "op": "writer", "on": "empty_bytes", "steps": [], "note": "a record with nothing in it, as a writer doesn't make short values" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "number" } } }, { "write": { "uint": 5 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "map" } } }, { "hash_map_init": {} }] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "now_long" } } }, { "write": { "bytes": "written in this transaction and long" } }], "as": "now_long" },
      { "op": "read_stream", "on": "now_long", "steps": [{ "seek": 8 }, { "read": 2, "expect": "in" }], "note": "a read-write cursor, before its commit" },
      { "op": "read_stream", "on": "now_long", "buffer_size": 1024, "steps": [{ "read": 7, "expect": "written" }, { "position": 7 }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "now_short" } } }, { "write": { "bytes": "hi" } }], "as": "now_short" },
      { "op": "read_stream", "on": "now_short", "steps": [{ "read": 10, "expect": "hi" }] }
    ] } }] },

    { "op": "read_path", "on": "root", "path": [{ "array_list_get": -1 }], "as": "moment" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "long" } } }], "as": "long" },
    { "op": "read_stream", "on": "long", "steps": [
      { "position": 0 },
      { "read": 4, "expect": "abcd" },
      { "position": 4 },
      { "read_all": 2, "expect": "ef" },
      { "position": 6 },
      { "seek": 0 },
      { "position": 0 },
      { "read": 3, "expect": "abc" },
      { "seek": 28 },
      { "read": 10, "expect": "23" },
      { "position": 30 },
      { "read": 10, "expect": "" },
      { "position": 30 },
      { "seek": 5 },
      { "read": 1, "expect": "f" },
      { "seek": 5 },
      { "read": 1, "expect": "f" },
      { "seek": 30 },
      { "read": 1, "expect": "" },
      { "seek": 1000 },
      { "position": 1000 },
      { "read": 1, "expect": "" },
      { "seek": 18446744073709551615 },
      { "position": 18446744073709551615 },
      { "read": 1, "expect": "" },
      { "seek": 0 },
      { "read": 0, "expect": "" },
      { "position": 0 },
      { "read_all": 0, "expect": "" },
      { "read_all": 30, "expect": "abcdefghijklmnopqrstuvwxyz0123" },
      { "read_all": 0, "expect": "" }
    ] },
    { "op": "read_stream", "on": "long", "buffer_size": 1, "steps": [
      { "position": 0 },
      { "read": 4, "expect": "abcd" },
      { "position": 4 },
      { "read_all": 2, "expect": "ef" },
      { "seek": 0 },
      { "read": 3, "expect": "abc" },
      { "seek": 28 },
      { "read": 10, "expect": "23" },
      { "position": 30 },
      { "read": 10, "expect": "" },
      { "seek": 5 },
      { "read": 1, "expect": "f" },
      { "seek": 1000 },
      { "read": 1, "expect": "" },
      { "seek": 0 },
      { "read_all": 30, "expect": "abcdefghijklmnopqrstuvwxyz0123" }
    ] },
    { "op": "read_stream", "on": "long", "buffer_size": 7, "steps": [
      { "read": 1, "expect": "a" },
      { "position": 1 },
      { "read": 1, "expect": "b" },
      { "position": 2 },
      { "seek": 4 },
      { "position": 4 },
      { "read": 1, "expect": "e" },
      { "seek": 1 },
      { "read": 2, "expect": "bc" },
      { "position": 3 },
      { "seek": 9 },
      { "read": 8, "expect": "jklmnopq" },
      { "position": 17 },
      { "seek": 28 },
      { "read": 10, "expect": "23" },
      { "position": 30 },
      { "read": 10, "expect": "" },
      { "seek": 0 },
      { "read_all": 30, "expect": "abcdefghijklmnopqrstuvwxyz0123" },
      { "position": 30 }
    ] },
    { "op": "read_stream", "on": "long", "buffer_size": 1024, "steps": [
      { "read": 1, "expect": "a" },
      { "position": 1 },
      { "seek": 20 },
      { "position": 20 },
      { "read": 2, "expect": "uv" },
      { "seek": 10 },
      { "read": 1, "expect": "k" },
      { "seek": 1000 },
      { "position": 1000 },
      { "read": 1, "expect": "" },
      { "seek": 29 },
      { "read": 5, "expect": "3" }
    ] },
    { "op": "read_stream", "on": "long", "steps": [] },
    { "op": "read_stream", "on": "long", "steps": [{ "seek": 28 }, { "read_all": 2, "expect": "23" }] },
    { "op": "read_stream", "on": "long", "steps": [{ "seek": 28 }, { "read_all": 3 }], "expect_error": "EndOfStream", "note": "exactly as much as it asks for, or an error" },
    { "op": "read_stream", "on": "long", "steps": [{ "seek": 30 }, { "read_all": 1 }], "expect_error": "EndOfStream" },
    { "op": "read_stream", "on": "long", "buffer_size": 7, "steps": [{ "seek": 1000 }, { "read_all": 1 }], "expect_error": "EndOfStream" },
    { "op": "read_stream", "on": "long", "buffer_size": 7, "steps": [{ "seek": 28 }, { "read_all": 3 }], "expect_error": "EndOfStream" },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "short" } } }], "as": "short" },
    { "op": "slot", "on": "short", "expect": { "tag": "short_bytes" } },
    { "op": "read_stream", "on": "short", "steps": [
      { "position": 0 },
      { "read": 2, "expect": "ba" },
      { "position": 2 },
      { "read": 10, "expect": "r" },
      { "position": 3 },
      { "read": 1, "expect": "" },
      { "seek": 1 },
      { "read_all": 2, "expect": "ar" },
      { "seek": 0 },
      { "read": 10, "expect": "bar" },
      { "seek": 1000 },
      { "read": 1, "expect": "" }
    ] },
    { "op": "read_stream", "on": "short", "buffer_size": 1024, "steps": [
      { "read": 1, "expect": "b" },
      { "position": 1 },
      { "read": 10, "expect": "ar" },
      { "seek": 0 },
      { "read": 3, "expect": "bar" }
    ] },
    { "op": "read_stream", "on": "short", "steps": [{ "seek": 3 }, { "read_all": 1 }], "expect_error": "EndOfStream" },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "eight" } } }], "as": "eight" },
    { "op": "slot", "on": "eight", "expect": { "tag": "short_bytes" } },
    { "op": "read_stream", "on": "eight", "steps": [{ "read": 100, "expect": "12345678" }, { "position": 8 }] },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "empty_short" } } }], "as": "empty_short" },
    { "op": "slot", "on": "empty_short", "expect": { "tag": "short_bytes" } },
    { "op": "read_stream", "on": "empty_short", "steps": [{ "read": 5, "expect": "" }, { "position": 0 }] },
    { "op": "read_stream", "on": "empty_short", "steps": [{ "read_all": 1 }], "expect_error": "EndOfStream" },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "empty_bytes" } } }], "as": "empty_bytes" },
    { "op": "slot", "on": "empty_bytes", "expect": { "tag": "bytes" } },
    { "op": "read_stream", "on": "empty_bytes", "steps": [{ "read": 5, "expect": "" }, { "position": 0 }] },
    { "op": "read_stream", "on": "empty_bytes", "buffer_size": 16, "steps": [{ "read": 5, "expect": "" }] },
    { "op": "read_stream", "on": "empty_bytes", "steps": [{ "read_all": 1 }], "expect_error": "EndOfStream" },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "zero" } } }], "as": "zero" },
    { "op": "slot", "on": "zero", "expect": { "tag": "bytes" } },
    { "op": "read_stream", "on": "zero", "steps": [{ "read": 10, "expect": { "hex": "610062" } }] },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "tagged_long" } } }], "as": "tagged_long", "note": "a format tag isn't part of what a stream gives" },
    { "op": "read_stream", "on": "tagged_long", "steps": [{ "seek": 15 }, { "read": 100, "expect": "that won't fit" }, { "position": 29 }] },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "tagged_short" } } }], "as": "tagged_short" },
    { "op": "read_stream", "on": "tagged_short", "steps": [{ "read": 100, "expect": "abc" }, { "position": 3 }] },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "tagged_six" } } }], "as": "tagged_six" },
    { "op": "slot", "on": "tagged_six", "expect": { "tag": "short_bytes", "full": true } },
    { "op": "read_stream", "on": "tagged_six", "steps": [{ "read": 100, "expect": "abcdef" }, { "position": 6 }] },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "number" } } }], "as": "number" },
    { "op": "read_stream", "on": "number", "steps": [], "expect_error": "UnexpectedTag" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "map" } } }], "as": "map" },
    { "op": "read_stream", "on": "map", "steps": [], "expect_error": "UnexpectedTag" },

    { "op": "read_path_slot", "on": "root", "path": [{ "array_list_get": -1 }], "as": "last" },
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "write": { "slot": { "var": "last" } } }, { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "long" } } }], "as": "kept_long" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "long" } } }, { "write": { "bytes": "a different long value to read" } }] },
      { "op": "read_stream", "on": "kept_long", "steps": [{ "read": 3, "expect": "abc" }], "note": "a long value's bytes aren't changed by a new value, so a stale cursor still gets what it saw" },
      { "op": "read_stream", "on": "long", "steps": [{ "read": 3, "expect": "abc" }] },
      { "op": "read_stream", "on": "short", "steps": [{ "read": 3, "expect": "bar" }], "note": "and a cursor from an earlier commit is fine when it's short, too" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "short" } } }, { "write": { "bytes": "yo" } }] },
      { "op": "read_stream", "on": "short", "steps": [{ "read": 3, "expect": "bar" }], "note": "the write above copied that entry, so the slot this cursor holds hasn't been touched" }
    ] } }] },
    { "op": "read_stream", "on": "long", "steps": [{ "read": 3, "expect": "abc" }] },
    { "op": "read_stream", "on": "short", "steps": [{ "read": 3, "expect": "bar" }] }
  ]
}
