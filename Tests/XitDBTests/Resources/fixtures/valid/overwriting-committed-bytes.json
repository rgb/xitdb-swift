{
  "format": "xitdb-script/1",
  "description": "The path API doesn't protect committed bytes. A path that skips a collection's init part, or a cursor kept from an earlier transaction, writes straight into them, so earlier moments change. This is what Zig does, and it isn't an error. The collection wrappers never do it, because they always run the init part.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "c0f0000000000006",
  "ops": [
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "array_list_init", "array_list_append", { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "map" } } }, { "hash_map_init": {} }, { "hash_map_get": { "value": { "sha1": "x" } } }, { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "kept" } } }, { "write": { "uint": 1 } }], "as": "kept" }
    ] } }] },
    { "op": "read_path", "on": "root", "path": [{ "array_list_get": 0 }], "as": "moment0" },
    { "op": "read_path_slot", "on": "root", "path": [{ "array_list_get": -1 }], "as": "last" },

    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "write": { "slot": { "var": "last" } } }, { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, { "array_list_get": 0 }, { "write": { "uint": 99 } }],
        "note": "no array_list_init, so this writes into the list's committed index block" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "array_list_append", { "write": { "uint": 2 } }],
        "note": "and this into its committed header" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "map" } } }, { "hash_map_get": { "value": { "sha1": "y" } } }, { "write": { "uint": 2 } }] },
      { "op": "write", "on": "kept", "data": { "uint": 2 }, "note": "a cursor from the previous transaction writes where it always pointed" },
      { "op": "read_path", "on": "moment0", "path": [{ "hash_map_get": { "value": { "sha1": "kept" } } }], "as": "c" },
      { "op": "read_uint", "on": "c", "expect": 2 },
      { "op": "write_path", "on": "kept", "path": [], "as": "rederived", "note": "making a new cursor from it in this transaction changes nothing" },
      { "op": "write", "on": "rederived", "data": { "uint": 3 } }
    ] } }] },

    { "op": "read_path", "on": "moment0", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }], "as": "c" },
    { "op": "count", "on": "c", "expect": 2, "note": "the first moment's list has grown" },
    { "op": "read_path", "on": "c", "path": [{ "array_list_get": 0 }], "as": "c" },
    { "op": "read_uint", "on": "c", "expect": 99, "note": "and its element has changed" },
    { "op": "read_path_slot", "on": "moment0", "path": [{ "hash_map_get": { "value": { "sha1": "map" } } }, { "hash_map_get": { "value": { "sha1": "y" } } }], "expect": { "tag": "uint", "value": 2 } },
    { "op": "read_path", "on": "moment0", "path": [{ "hash_map_get": { "value": { "sha1": "kept" } } }], "as": "c" },
    { "op": "read_uint", "on": "c", "expect": 3 },

    { "op": "run_context", "ctx": { "as": "c2", "ops": [
      { "op": "write", "on": "rederived", "data": { "uint": 4 } },
      { "op": "fail" }
    ] }, "expect_error": "ScriptAbort", "note": "a rollback only truncates, so it doesn't undo this" },
    { "op": "read_uint", "on": "c", "expect": 3, "note": "this cursor goes by its snapshot" },
    { "op": "read_path", "on": "moment0", "path": [{ "hash_map_get": { "value": { "sha1": "kept" } } }], "as": "c" },
    { "op": "read_uint", "on": "c", "expect": 4 }
  ]
}
