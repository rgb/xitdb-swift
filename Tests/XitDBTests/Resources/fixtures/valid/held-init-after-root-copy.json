{
  "format": "xitdb-script/1",
  "description": "Section F's lost write, with no concat: after a db_freeze, the init allowed through a cursor held from before it writes where its copy is into the cursor's slot in place, and if something has copied the record that slot is in, the root no longer reaches the write. In the first transaction, a path from the root copies the root's record, and y, written through the held cursor on a, is lost. In the second, nothing goes from the root: an init through one held cursor, whose get copies x's record, and then an init through another held cursor on x, whose second element is lost. Zig and the port both lose them, as each init is allowed after a freeze (D22 item 1). Finding 29 is the same thing, seen from a clone.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "c0f0000000000024",
  "ops": [
    { "op": "write_path", "on": "root", "path": [{ "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "a" } } }, { "hash_map_init": {} }, { "hash_map_get": { "value": { "sha1": "x" } } }, { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "a" } } }], "as": "held" },
      { "op": "db_freeze" },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_init": {} }, { "hash_map_get": { "value": { "sha1": "a" } } }], "as": "a_from_root", "note": "a path from the root: the init copies the root's record, and the get a's entry" },
      { "op": "write_path", "on": "held", "path": [{ "hash_map_init": {} }, { "hash_map_get": { "value": { "sha1": "y" } } }, { "write": { "uint": 2 } }], "note": "copies a's map, and writes where it is into held's slot, in the record the root no longer reaches" }
    ] } }] },
    { "op": "read_path", "on": "root", "path": [{ "hash_map_get": { "value": { "sha1": "a" } } }, { "hash_map_get": { "value": { "sha1": "y" } } }], "expect_null": true, "note": "y is lost" },
    { "op": "read_path", "on": "root", "path": [{ "hash_map_get": { "value": { "sha1": "a" } } }, { "hash_map_get": { "value": { "sha1": "x" } } }], "as": "x_now" },
    { "op": "read_uint", "on": "x_now", "expect": 1 },

    { "op": "write_path", "on": "root", "path": [{ "hash_map_init": {} }, { "ctx": { "as": "n", "ops": [
      { "op": "write_path", "on": "n", "path": [{ "hash_map_get": { "value": { "sha1": "b" } } }, { "hash_map_init": {} }, { "hash_map_get": { "value": { "sha1": "x" } } }, "array_list_init", "array_list_append", { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "n", "path": [{ "hash_map_get": { "value": { "sha1": "b" } } }], "as": "held_b" },
      { "op": "write_path", "on": "n", "path": [{ "hash_map_get": { "value": { "sha1": "b" } } }, { "hash_map_get": { "value": { "sha1": "x" } } }], "as": "held_x" },
      { "op": "db_freeze" },
      { "op": "write_path", "on": "held_b", "path": [{ "hash_map_init": {} }, { "hash_map_get": { "value": { "sha1": "x" } } }], "as": "x_copied", "note": "an init through a held cursor, and the get copies x's record" },
      { "op": "write_path", "on": "held_x", "path": ["array_list_init", "array_list_append", { "write": { "uint": 2 } }], "note": "an init through another, whose slot is in the record that was copied" }
    ] } }] },
    { "op": "read_path", "on": "root", "path": [{ "hash_map_get": { "value": { "sha1": "b" } } }, { "hash_map_get": { "value": { "sha1": "x" } } }], "as": "b_x" },
    { "op": "count", "on": "b_x", "expect": 1, "note": "its second element is lost" }
  ]
}
