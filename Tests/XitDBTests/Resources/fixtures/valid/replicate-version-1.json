{
  "format": "xitdb-script/1",
  "description": "Replication with version 1 files written at 6b93af1 (inputs/v1-history and inputs/v1-new). A copy from 0 takes the source's database header, so a version 1 source makes a version 1 replica, and a version 2 source over a version 1 replica makes it version 2, and the other way round. A read from 0 on a version 1 file gives its bytes before the committed size as they are: the copy of the root slot at 20 to 28, which the last commit at 6b93af1 left there and nothing updates now, and then the committed size at 29. A copy writes zeros there instead, so a read from 0 on the replica differs from what was sent in exactly those nine bytes. An incremental sync then leaves both version 1, and the copy of the root slot as it was in each.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "c0f0000000000001",
  "ops": [
    { "op": "close" },
    { "op": "raw_load", "input": "v1-history", "note": "two moments, so the copy of the root slot is the list at the root" },
    { "op": "reopen" },
    { "op": "committed_size", "expect": 1215 },
    { "op": "read_committed", "start": 0, "end": 1215, "as": "sent" },
    { "op": "create_database", "name": "replica", "file_id": "0000000000000002" },
    { "op": "use", "name": "replica" },
    { "op": "apply_replicated", "start": 0, "bytes": "sent", "note": "now version 1, with main's database header" },
    { "op": "committed_size", "expect": 1215 },
    { "op": "count", "on": "root", "expect": 2 },
    { "op": "read_committed", "start": 0, "end": 1215, "as": "from_replica" },

    { "op": "create_database", "name": "zeroed", "file_id": "0000000000000003" },
    { "op": "use", "name": "zeroed" },
    { "op": "close" },
    { "op": "raw_load", "input": "v1-history" },
    { "op": "raw_write", "offset": 20, "bytes": { "hex": "000000000000000000" }, "note": "the source with zeros for the copy of the root slot" },
    { "op": "reopen" },
    { "op": "read_committed", "start": 0, "end": 1215, "as": "zeros" },
    { "op": "use", "name": "replica" },
    { "op": "read_committed", "start": 0, "end": 1215, "as": "from_replica", "expect_same": "zeros", "note": "reads the same as the replica, so that's all the replica's read differs in" },

    { "op": "use", "name": "main" },
    { "op": "read_path_slot", "on": "root", "path": [{ "array_list_get": -1 }], "as": "last" },
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "write": { "slot": { "var": "last" } } }, { "hash_map_init": {} }, { "hash_map_get": { "value": { "sha1": "b" } } }, { "write": { "uint": 2 } }], "note": "a commit to a version 1 file, which writes the committed size at 29 and nothing before it" },
    { "op": "committed_size", "as": "end" },
    { "op": "use", "name": "replica" },
    { "op": "replica_state", "as": "state" },
    { "op": "use", "name": "main" },
    { "op": "replication_start", "state": "state", "as": "start", "expect": 1215 },
    { "op": "read_committed", "start": { "var": "start" }, "end": { "var": "end" }, "as": "rest" },
    { "op": "use", "name": "replica" },
    { "op": "apply_replicated", "start": { "var": "start" }, "bytes": "rest" },
    { "op": "committed_size", "expect": { "var": "end" } },
    { "op": "count", "on": "root", "expect": 3 },

    { "op": "create_database", "name": "v1_replica", "file_id": "0000000000000005" },
    { "op": "use", "name": "v1_replica" },
    { "op": "close" },
    { "op": "raw_load", "input": "v1-new" },
    { "op": "reopen" },
    { "op": "committed_size", "expect": 62, "note": "a new version 1 database" },
    { "op": "create_database", "name": "v2_source", "file_id": "0000000000000004" },
    { "op": "use", "name": "v2_source" },
    { "op": "write", "on": "root", "data": { "uint": 7 } },
    { "op": "read_committed", "start": 0, "end": 91, "as": "v2_bytes" },
    { "op": "use", "name": "v1_replica" },
    { "op": "apply_replicated", "start": 0, "bytes": "v2_bytes", "note": "replaced by a version 2 source, it's version 2" },
    { "op": "committed_size", "expect": 91 },
    { "op": "read_uint", "on": "root", "expect": 7 },
    { "op": "read_committed", "start": 0, "end": 91, "as": "got", "expect_same": "v2_bytes", "note": "the source's padding is zeros, so a read from 0 is what was sent" },

    { "op": "create_database", "name": "v2_replica", "file_id": "0000000000000006" },
    { "op": "use", "name": "v2_replica" },
    { "op": "write", "on": "root", "data": { "uint": 9 } },
    { "op": "use", "name": "main" },
    { "op": "committed_size", "as": "end" },
    { "op": "read_committed", "start": 0, "end": { "var": "end" }, "as": "v1_bytes" },
    { "op": "use", "name": "v2_replica" },
    { "op": "apply_replicated", "start": 0, "bytes": "v1_bytes", "note": "a version 2 database replaced by a version 1 source is version 1" },
    { "op": "committed_size", "expect": { "var": "end" } },
    { "op": "count", "on": "root", "expect": 3 }
  ]
}
