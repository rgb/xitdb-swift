{
  "format": "xitdb-script/1",
  "description": "The part of every-construct that needs linked array lists, with what the port does. A concat freezes after its join, as Zig does from b12b8bd on, so what comes after it copies the joined nodes. What it gives back is fresh. Any other cursor made before it raises StaleCursor on a write, and can still be read, or go on with an init.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "c0f0000000000007",
  "ops": [
    { "op": "write_path", "on": "root", "path": [
      "array_list_init",
      "array_list_append",
      { "hash_map_init": {} },
      { "ctx": { "as": "m", "ops": [
        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "linked-a" } } }, "linked_array_list_init"], "as": "la" },
        { "op": "write_path", "on": "la", "path": ["linked_array_list_append", { "write": { "uint": 1 } }] },
        { "op": "write_path", "on": "la", "path": ["linked_array_list_append", { "write": { "uint": 2 } }] },
        { "op": "write_path", "on": "la", "path": ["linked_array_list_append", { "write": { "uint": 3 } }] },
        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "linked-b" } } }, "linked_array_list_init"], "as": "lb" },
        { "op": "write_path", "on": "lb", "path": ["linked_array_list_append", { "write": { "uint": 4 } }] },
        { "op": "write_path", "on": "lb", "path": ["linked_array_list_append", { "write": { "uint": 5 } }] },
        { "op": "slot", "on": "lb", "as": "lb_slot" },
        { "op": "write_path", "on": "la", "path": [{ "linked_array_list_concat": { "list": { "var": "lb_slot" } } }], "as": "la_fresh", "note": "what it gives back is fresh" },
        { "op": "count", "on": "la_fresh", "expect": 5 },
        { "op": "write_path", "on": "la_fresh", "path": [{ "linked_array_list_get": -1 }, { "write": { "uint": 50 } }], "note": "and this copies the joined nodes, as they're older than the freeze" },
        { "op": "write_path", "on": "la", "path": ["linked_array_list_append", { "write": { "uint": 6 } }], "expect_error": "StaleCursor", "note": "nothing else from before it is, on a write" },
        { "op": "write", "on": "la", "data": { "uint": 6 }, "expect_error": "StaleCursor" },
        { "op": "write_if_empty", "on": "la", "data": { "uint": 6 }, "expect_error": "StaleCursor" },
        { "op": "writer", "on": "la", "steps": [{ "write": "x" }], "expect_error": "StaleCursor" },
        { "op": "write_path", "on": "la", "path": [], "as": "not_bound", "expect_error": "StaleCursor", "note": "an empty path would give it a fresh cursor without an init" },
        { "op": "write_path", "on": "lb", "path": ["linked_array_list_append", { "write": { "uint": 6 } }], "expect_error": "StaleCursor" },
        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "linked-a" } } }, { "write": { "uint": 6 } }], "expect_error": "StaleCursor" },
        { "op": "read_path", "on": "la", "path": [{ "linked_array_list_get": 0 }], "as": "lv", "note": "reading through one is fine" },
        { "op": "read_uint", "on": "lv", "expect": 1 },
        { "op": "write_path", "on": "la", "path": ["linked_array_list_init"], "as": "la", "note": "and so is an init, which is the way to go on" },
        { "op": "count", "on": "la", "expect": 5 },
        { "op": "write_path", "on": "la", "path": [{ "linked_array_list_concat": { "list": { "tag": "uint" } } }], "expect_error": "UnexpectedTag",
          "note": "a literal slot, which is not a list" },
        { "op": "write_path", "on": "la", "path": [{ "linked_array_list_slice": { "offset": 1, "size": 4 } }] },
        { "op": "write_path", "on": "la", "path": [{ "linked_array_list_slice": { "offset": 18446744073709551615, "size": 1 } }], "expect_error": "KeyNotFound" },
        { "op": "write_path", "on": "la", "path": [{ "linked_array_list_slice": { "offset": 1, "size": 18446744073709551615 } }], "expect_error": "KeyNotFound",
          "note": "offset + size wraps around, and has to be caught anyway" },
        { "op": "write_path", "on": "la", "path": [{ "linked_array_list_remove": 0 }] },
        { "op": "write_path", "on": "la", "path": [{ "linked_array_list_insert": -1 }, { "write": { "uint": 45 } }] },
        { "op": "write_path", "on": "la", "path": [{ "linked_array_list_get": 9 }], "expect_error": "KeyNotFound" },
        { "op": "count", "on": "la", "expect": 4 },
        { "op": "write_path", "on": "la", "path": [{ "linked_array_list_get": 0 }], "as": "lv" },
        { "op": "read_uint", "on": "lv", "expect": 3 },
        { "op": "write_path", "on": "la", "path": [{ "linked_array_list_get": 2 }], "as": "lv" },
        { "op": "read_uint", "on": "lv", "expect": 45 },
        { "op": "write_path", "on": "la", "path": [{ "linked_array_list_get": 3 }], "as": "lv" },
        { "op": "read_uint", "on": "lv", "expect": 50 },
        { "op": "slot", "on": "la", "expect": { "tag": "linked_array_list" } },
        { "op": "write_path", "on": "m", "path": [{ "hash_map_init": {} }, { "hash_map_get": { "value": { "sha1": "after-a-concat" } } }, { "write": { "uint": 7 } }], "note": "and a path that starts with an init goes on through what it made" },
        { "op": "read_path_slot", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "linked-a" } } }], "expect": { "tag": "linked_array_list" } }
      ] } }
    ] }
  ]
}
