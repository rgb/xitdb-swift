{
  "format": "xitdb-script/1",
  "description": "Iterators and rank on a sorted map and a sorted set: the order, where they start, what they give, and what they raise. Keys that fit in a slot are mixed with keys that don't.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "0011223344556677",
  "ops": [
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sorted" } } }, { "sorted_map_init": {} }, { "sorted_map_get": { "value": "cherry" } }, { "write": { "uint": 3 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sorted" } } }, { "sorted_map_init": {} }, { "sorted_map_get": { "value": "apple" } }, { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sorted" } } }, { "sorted_map_init": {} }, { "sorted_map_get": { "value": "banana, which is too long for a slot" } }, { "write": { "uint": 2 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sorted" } } }, { "sorted_map_init": {} }, { "sorted_map_get": { "value": { "hex": "ff00" } } }, { "write": { "uint": 4 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "empty_map" } } }, { "sorted_map_init": {} }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "set" } } }, { "sorted_map_init": { "set": true } }, { "sorted_map_get": { "key": "mid" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "set" } } }, { "sorted_map_init": { "set": true } }, { "sorted_map_get": { "key": "a much longer key that is stored separately" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "set" } } }, { "sorted_map_init": { "set": true } }, { "sorted_map_get": { "key": "short" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "number" } } }, { "write": { "uint": 5 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "plain" } } }, { "hash_map_init": {} }] }
    ] } }] },

    { "op": "read_path", "on": "root", "path": [{ "array_list_get": -1 }], "as": "moment" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "sorted" } } }], "as": "sorted" },
    { "op": "iterator", "on": "sorted", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "slot", "on": "e", "expect": { "tag": "sorted_kv_pair" } },
    { "op": "read_key_value_pair", "on": "e", "key_as": "k", "value_as": "v", "expect_hash": { "hex": "0000000000000000000000000000000000000000" } },
    { "op": "read_bytes", "on": "k", "expect": "apple" },
    { "op": "read_uint", "on": "v", "expect": 1 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "key_as": "k", "value_as": "v" },
    { "op": "read_bytes", "on": "k", "expect": "banana, which is too long for a slot" },
    { "op": "read_uint", "on": "v", "expect": 2 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "key_as": "k", "value_as": "v" },
    { "op": "read_bytes", "on": "k", "expect": "cherry" },
    { "op": "read_uint", "on": "v", "expect": 3 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "key_as": "k", "value_as": "v" },
    { "op": "read_bytes", "on": "k", "expect": { "hex": "ff00" } },
    { "op": "read_uint", "on": "v", "expect": 4 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "iterator", "on": "sorted", "from_index": 2, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "key_as": "k" },
    { "op": "read_bytes", "on": "k", "expect": "cherry" },
    { "op": "iterator", "on": "sorted", "from_index": -1, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "value_as": "v" },
    { "op": "read_uint", "on": "v", "expect": 4 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "sorted", "from_index": -4, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "value_as": "v" },
    { "op": "read_uint", "on": "v", "expect": 1 },
    { "op": "iterator", "on": "sorted", "from_index": 4, "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "sorted", "from_index": -5, "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "iterator", "on": "sorted", "from_key": "cherry", "as": "it", "note": "a key that's there starts there" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "value_as": "v" },
    { "op": "read_uint", "on": "v", "expect": 3 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "value_as": "v" },
    { "op": "read_uint", "on": "v", "expect": 4 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "sorted", "from_key": "b", "as": "it", "note": "one that isn't starts at the next one after it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "value_as": "v" },
    { "op": "read_uint", "on": "v", "expect": 2 },
    { "op": "iterator", "on": "sorted", "from_key": { "hex": "" }, "as": "it", "note": "the empty key comes before all of them" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "value_as": "v" },
    { "op": "read_uint", "on": "v", "expect": 1 },
    { "op": "iterator", "on": "sorted", "from_key": { "hex": "ff00" }, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "value_as": "v" },
    { "op": "read_uint", "on": "v", "expect": 4 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "sorted", "from_key": { "hex": "ff0000" }, "as": "it", "note": "a key after them all gives nothing" },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "rank", "on": "sorted", "key": "apple", "expect": 0 },
    { "op": "rank", "on": "sorted", "key": "banana, which is too long for a slot", "expect": 1 },
    { "op": "rank", "on": "sorted", "key": "cherry", "expect": 2 },
    { "op": "rank", "on": "sorted", "key": { "hex": "ff00" }, "expect": 3 },
    { "op": "rank", "on": "sorted", "key": "b", "expect": 1, "note": "the keys that are less than this one, whether or not it's there" },
    { "op": "rank", "on": "sorted", "key": { "hex": "" }, "expect": 0 },
    { "op": "rank", "on": "sorted", "key": { "hex": "ff0000" }, "expect": 4 },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "empty_map" } } }], "as": "empty_map" },
    { "op": "iterator", "on": "empty_map", "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "empty_map", "from_index": 0, "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "empty_map", "from_key": "a", "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "rank", "on": "empty_map", "key": "a", "expect": 0 },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "set" } } }], "as": "set", "note": "an entry in a set is its key, and has no value slot and no slot for the key apart from itself" },
    { "op": "iterator", "on": "set", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "slot", "on": "e", "expect": { "tag": "bytes" } },
    { "op": "read_bytes", "on": "e", "expect": "a much longer key that is stored separately" },
    { "op": "read_key_value_pair", "on": "e", "key_as": "k", "value_as": "v", "expect_hash": { "hex": "0000000000000000000000000000000000000000" } },
    { "op": "read_bytes", "on": "k", "expect": "a much longer key that is stored separately" },
    { "op": "slot", "on": "v", "expect": { "tag": "none", "full": false } },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "slot", "on": "e", "expect": { "tag": "short_bytes" } },
    { "op": "read_bytes", "on": "e", "expect": "mid" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "key_as": "k" },
    { "op": "read_bytes", "on": "k", "expect": "short" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "set", "from_key": "n", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_bytes", "on": "e", "expect": "short" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "set", "from_index": 1, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_bytes", "on": "e", "expect": "mid" },
    { "op": "rank", "on": "set", "key": "mid", "expect": 1 },
    { "op": "rank", "on": "set", "key": "z", "expect": 3 },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "number" } } }], "as": "number" },
    { "op": "rank", "on": "number", "key": "a", "expect_error": "UnexpectedTag" },
    { "op": "iterator", "on": "number", "from_key": "a", "as": "not_this", "expect_error": "UnexpectedTag" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "plain" } } }], "as": "plain" },
    { "op": "rank", "on": "plain", "key": "a", "expect_error": "UnexpectedTag" },
    { "op": "iterator", "on": "plain", "from_key": "a", "as": "not_this", "expect_error": "UnexpectedTag" },
    { "op": "iterator", "on": "plain", "from_index": 0, "as": "not_this", "expect_error": "UnexpectedTag" },

    { "op": "iterator", "on": "sorted", "as": "kept" },
    { "op": "next", "on": "kept", "as": "e", "expect_null": false },
    { "op": "read_path_slot", "on": "root", "path": [{ "array_list_get": -1 }], "as": "last" },
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "write": { "slot": { "var": "last" } } }, { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sorted" } } }, { "sorted_map_init": {} }, { "sorted_map_remove": "cherry" }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sorted" } } }, { "sorted_map_init": {} }, { "sorted_map_get": { "value": "date" } }, { "write": { "uint": 5 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sorted" } } }, { "sorted_map_init": {} }], "as": "new_sorted" },
      { "op": "rank", "on": "new_sorted", "key": "date", "expect": 2, "note": "a read-write cursor sees this transaction" },
      { "op": "rank", "on": "sorted", "key": "date", "expect": 3, "note": "and one from before doesn't" },
      { "op": "iterator", "on": "new_sorted", "from_key": "c", "as": "it" },
      { "op": "next", "on": "it", "as": "e", "expect_null": false },
      { "op": "read_key_value_pair", "on": "e", "value_as": "v" },
      { "op": "read_uint", "on": "v", "expect": 5 },
      { "op": "next", "on": "kept", "as": "e", "expect_null": false, "note": "this iterator's transaction is over, and the writes above copied what it reads" },
      { "op": "read_key_value_pair", "on": "e", "value_as": "v" },
      { "op": "read_uint", "on": "v", "expect": 2 }
    ] } }] },
    { "op": "next", "on": "kept", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "value_as": "v" },
    { "op": "read_uint", "on": "v", "expect": 3 },
    { "op": "next", "on": "kept", "expect_null": false },
    { "op": "next", "on": "kept", "expect_null": true },
    { "op": "rank", "on": "new_sorted", "key": "date", "expect": 2 }
  ]
}
