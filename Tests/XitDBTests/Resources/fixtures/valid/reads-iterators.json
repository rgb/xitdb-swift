{
  "format": "xitdb-script/1",
  "description": "Iterators on array lists and the four kinds of hash map: what they give, in what order, where they start, what they raise, and what they see of a transaction. Hashes are written in hex where the order matters: a trie goes by the lowest nibble first.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "0011223344556677",
  "ops": [
    { "op": "iterator", "on": "root", "as": "it", "note": "the root of an empty database is a slot with nothing in it, so there's nothing to give" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "next", "on": "it", "expect_null": true, "note": "and it goes on giving nothing" },
    { "op": "iterator", "on": "root", "from_index": 0, "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "root", "from_key": "a", "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "array_list_init", "array_list_append", { "write": { "uint": 10 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "array_list_init", "array_list_append", { "write": { "uint": 20 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "array_list_init", "array_list_append", { "write": { "uint": 30 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "empty_list" } } }, "array_list_init"] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "holes" } } }, "array_list_init", "array_list_append"] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "holes" } } }, "array_list_init", "array_list_append", { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "holes" } } }, "array_list_init", "array_list_append"] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "holes" } } }, "array_list_init", "array_list_append", { "write": { "uint": 3 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "nulls" } } }, "array_list_init", "array_list_append", { "write": { "slot": null } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "nulls" } } }, "array_list_init", "array_list_append", { "write": { "uint": 7 } }] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "map" } } }, { "hash_map_init": {} }, { "hash_map_get": { "value": { "hex": "0000000000000000000000000000000000000002" } } }, { "write": { "uint": 2 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "map" } } }, { "hash_map_init": {} }, { "hash_map_get": { "value": { "hex": "0000000000000000000000000000000000000021" } } }, { "write": { "uint": 21 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "map" } } }, { "hash_map_init": {} }, { "hash_map_get": { "value": { "hex": "0000000000000000000000000000000000000001" } } }, { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "map" } } }, { "hash_map_init": {} }, { "hash_map_get": { "key": { "hex": "0000000000000000000000000000000000000001" } } }, { "write": { "bytes": "the key" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "map" } } }, { "hash_map_init": {} }, { "hash_map_get": { "value": { "hex": "0000000000000000000000000000000000000011" } } }, { "write": { "uint": 11 } }] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "counted" } } }, { "hash_map_init": { "counted": true } }, { "hash_map_get": { "value": { "hex": "0000000000000000000000000000000000000002" } } }, { "write": { "uint": 2 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "counted" } } }, { "hash_map_init": { "counted": true } }, { "hash_map_get": { "value": { "hex": "0000000000000000000000000000000000000001" } } }, { "write": { "uint": 1 } }] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "set" } } }, { "hash_map_init": { "set": true } }, { "hash_map_get": { "key": { "hex": "0000000000000000000000000000000000000003" } } }, { "write": { "bytes": "c" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "set" } } }, { "hash_map_init": { "set": true } }, { "hash_map_get": { "key": { "hex": "0000000000000000000000000000000000000001" } } }, { "write": { "bytes": "a" } }] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "counted_set" } } }, { "hash_map_init": { "counted": true, "set": true } }, { "hash_map_get": { "key": { "hex": "0000000000000000000000000000000000000002" } } }, { "write": { "bytes": "b" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "counted_set" } } }, { "hash_map_init": { "counted": true, "set": true } }, { "hash_map_get": { "key": { "hex": "0000000000000000000000000000000000000001" } } }, { "write": { "bytes": "a" } }] },

      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "number" } } }, { "write": { "uint": 5 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "text" } } }, { "write": { "bytes": "some text" } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "nothing" } } }] }
    ] } }] },

    { "op": "iterator", "on": "root", "as": "moments", "note": "the root can be iterated like anything else" },
    { "op": "next", "on": "moments", "as": "moment", "expect_null": false },
    { "op": "slot", "on": "moment", "expect": { "tag": "hash_map" } },
    { "op": "next", "on": "moments", "as": "gone", "expect_null": true },
    { "op": "iterator", "on": "moment", "as": "it", "note": "and what an iterator gives can be iterated. there are 11 keys, and their order depends on their hashes" },
    { "op": "next", "on": "it", "expect_null": false },
    { "op": "next", "on": "it", "expect_null": false },
    { "op": "next", "on": "it", "expect_null": false },
    { "op": "next", "on": "it", "expect_null": false },
    { "op": "next", "on": "it", "expect_null": false },
    { "op": "next", "on": "it", "expect_null": false },
    { "op": "next", "on": "it", "expect_null": false },
    { "op": "next", "on": "it", "expect_null": false },
    { "op": "next", "on": "it", "expect_null": false },
    { "op": "next", "on": "it", "expect_null": false },
    { "op": "next", "on": "it", "expect_null": false },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }], "as": "list" },
    { "op": "iterator", "on": "list", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 10 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 20 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 30 },
    { "op": "next", "on": "it", "as": "e", "expect_null": true },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "list", "from_index": 1, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 20 },
    { "op": "iterator", "on": "list", "from_index": -1, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 30 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "list", "from_index": -3, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 10 },
    { "op": "iterator", "on": "list", "from_index": 3, "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "list", "from_index": -4, "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "list", "from_index": 9223372036854775807, "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "list", "from_index": -9223372036854775808, "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "list", "from_key": "a", "as": "not_this", "expect_error": "UnexpectedTag", "note": "only a sorted collection has keys to start from" },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "empty_list" } } }], "as": "empty_list" },
    { "op": "iterator", "on": "empty_list", "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "empty_list", "from_index": 0, "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "holes" } } }], "as": "holes", "note": "an element appended and never written counts, and is skipped" },
    { "op": "count", "on": "holes", "expect": 4 },
    { "op": "iterator", "on": "holes", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 1 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 3 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "holes", "from_index": 2, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 3 },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "nulls" } } }], "as": "nulls", "note": "one written with nothing isn't skipped" },
    { "op": "iterator", "on": "nulls", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "slot", "on": "e", "expect": { "tag": "none", "full": true } },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 7 },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "map" } } }], "as": "map", "note": "the hashes end in 01, 11, 21 and 02: nibble 1 comes first, and goes down a level to sort those three out" },
    { "op": "iterator", "on": "map", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "slot", "on": "e", "expect": { "tag": "kv_pair" } },
    { "op": "read_key_value_pair", "on": "e", "key_as": "k", "value_as": "v", "expect_hash": { "hex": "0000000000000000000000000000000000000001" } },
    { "op": "read_bytes", "on": "k", "expect": "the key" },
    { "op": "read_uint", "on": "v", "expect": 1 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "key_as": "k", "value_as": "v", "expect_hash": { "hex": "0000000000000000000000000000000000000011" } },
    { "op": "slot", "on": "k", "expect": { "tag": "none", "full": false } },
    { "op": "read_uint", "on": "v", "expect": 11 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "value_as": "v", "expect_hash": { "hex": "0000000000000000000000000000000000000021" } },
    { "op": "read_uint", "on": "v", "expect": 21 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "value_as": "v", "expect_hash": { "hex": "0000000000000000000000000000000000000002" } },
    { "op": "read_uint", "on": "v", "expect": 2 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "map", "from_index": 0, "as": "not_this", "expect_error": "UnexpectedTag", "note": "a hash map has no index to start from" },
    { "op": "iterator", "on": "map", "from_key": "a", "as": "not_this", "expect_error": "UnexpectedTag" },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "counted" } } }], "as": "counted" },
    { "op": "count", "on": "counted", "expect": 2 },
    { "op": "iterator", "on": "counted", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "value_as": "v", "expect_hash": { "hex": "0000000000000000000000000000000000000001" } },
    { "op": "read_uint", "on": "v", "expect": 1 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "value_as": "v", "expect_hash": { "hex": "0000000000000000000000000000000000000002" } },
    { "op": "read_uint", "on": "v", "expect": 2 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "counted", "from_index": 0, "as": "not_this", "expect_error": "UnexpectedTag" },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "set" } } }], "as": "set" },
    { "op": "iterator", "on": "set", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "key_as": "k", "value_as": "v" },
    { "op": "read_bytes", "on": "k", "expect": "a" },
    { "op": "slot", "on": "v", "expect": { "tag": "none", "full": false } },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "key_as": "k" },
    { "op": "read_bytes", "on": "k", "expect": "c" },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "counted_set" } } }], "as": "counted_set" },
    { "op": "count", "on": "counted_set", "expect": 2 },
    { "op": "iterator", "on": "counted_set", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "key_as": "k" },
    { "op": "read_bytes", "on": "k", "expect": "a" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_key_value_pair", "on": "e", "key_as": "k" },
    { "op": "read_bytes", "on": "k", "expect": "b" },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "number" } } }], "as": "number", "note": "the rest can't be iterated, however it starts" },
    { "op": "iterator", "on": "number", "as": "not_this", "expect_error": "UnexpectedTag" },
    { "op": "iterator", "on": "number", "from_index": 0, "as": "not_this", "expect_error": "UnexpectedTag" },
    { "op": "iterator", "on": "number", "from_key": "a", "as": "not_this", "expect_error": "UnexpectedTag" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "text" } } }], "as": "text" },
    { "op": "iterator", "on": "text", "as": "not_this", "expect_error": "UnexpectedTag" },
    { "op": "read_path", "on": "map", "path": [{ "hash_map_get": { "kv_pair": { "hex": "0000000000000000000000000000000000000001" } } }], "as": "pair" },
    { "op": "iterator", "on": "pair", "as": "not_this", "expect_error": "UnexpectedTag" },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "nothing" } } }], "expect_null": true, "note": "a value that was never written reads as null by path, and it's through its pair that there's a cursor for it, which is like the empty root" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "kv_pair": { "sha1": "nothing" } } }], "as": "pair" },
    { "op": "read_key_value_pair", "on": "pair", "value_as": "nothing" },
    { "op": "slot", "on": "nothing", "expect": { "tag": "none", "full": false } },
    { "op": "iterator", "on": "nothing", "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "nothing", "from_index": 5, "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "nothing", "from_key": "a", "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "iterator", "on": "list", "as": "kept", "note": "an iterator kept across a commit goes on seeing what it saw, as committed data isn't changed" },
    { "op": "next", "on": "kept", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 10 },

    { "op": "read_path_slot", "on": "root", "path": [{ "array_list_get": -1 }], "as": "last" },
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "write": { "slot": { "var": "last" } } }, { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "iterator", "on": "root", "as": "moments", "note": "a root cursor doesn't see this transaction, so there's still only the one moment" },
      { "op": "next", "on": "moments", "expect_null": false },
      { "op": "next", "on": "moments", "expect_null": true },
      { "op": "next", "on": "kept", "as": "e", "expect_null": false, "note": "and an iterator from before can be used during a transaction" },
      { "op": "read_uint", "on": "e", "expect": 20 },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "array_list_init", "array_list_append", { "write": { "uint": 40 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "array_list_init"], "as": "new_list" },
      { "op": "next", "on": "kept", "as": "e", "expect_null": false, "note": "even after a write, which copied what it's reading" },
      { "op": "read_uint", "on": "e", "expect": 30 },
      { "op": "next", "on": "kept", "expect_null": true },
      { "op": "iterator", "on": "new_list", "from_index": -1, "as": "it", "note": "a read-write cursor gives an iterator too, which sees this transaction" },
      { "op": "next", "on": "it", "as": "e", "expect_null": false },
      { "op": "read_uint", "on": "e", "expect": 40 },
      { "op": "next", "on": "it", "expect_null": true }
    ] } }] },

    { "op": "iterator", "on": "new_list", "as": "it", "note": "the read-write cursor is still good for this after its transaction" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 10 },
    { "op": "read_only", "on": "new_list", "as": "read_only_list" },
    { "op": "iterator", "on": "read_only_list", "from_index": 3, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 40 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "root", "from_index": -1, "as": "it" },
    { "op": "next", "on": "it", "as": "top", "expect_null": false },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "list", "from_index": -1, "as": "it", "note": "and the first moment's list still has three" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 30 }
  ]
}
