{
  "format": "xitdb-script/1",
  "description": "Array lists in version 1 files written at 6b93af1, read at 89da8e7, where an element appended and never written is a truly empty slot (inputs/v1-holes, inputs/v1-one-unwritten, inputs/v1-unwritten-last). It counts, a lookup gives null for it, and an iterator skips it, and with nothing past the list's end, the iterator stops there, so the original and the port agree. What they don't agree on is a slice that leaves something past the end, in tests/port-differs/iterator-past-slice. A file written now has a none slot marked full there instead (unwritten-elements).",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "0011223344556677",
  "ops": [
    { "op": "close" },
    { "op": "raw_load", "input": "v1-holes", "note": "its last moment holds holes, which was [never written, 1, never written, 3]" },
    { "op": "reopen" },
    { "op": "read_path", "on": "root", "path": [{ "array_list_get": -1 }, { "hash_map_get": { "value": { "sha1": "holes" } } }], "as": "holes" },
    { "op": "count", "on": "holes", "expect": 4 },
    { "op": "read_path_slot", "on": "holes", "path": [{ "array_list_get": 0 }], "expect_null": true },
    { "op": "read_path_slot", "on": "holes", "path": [{ "array_list_get": 1 }], "expect": { "tag": "uint", "value": 1 } },
    { "op": "read_path_slot", "on": "holes", "path": [{ "array_list_get": 2 }], "expect_null": true },
    { "op": "iterator", "on": "holes", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 1 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 3 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "holes", "from_index": 1, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 1 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 3 },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "create_database", "name": "one", "file_id": "0000000000000002" },
    { "op": "use", "name": "one" },
    { "op": "close" },
    { "op": "raw_load", "input": "v1-one-unwritten", "note": "a list at the root of one element, never written" },
    { "op": "reopen" },
    { "op": "count", "on": "root", "expect": 1 },
    { "op": "read_path_slot", "on": "root", "path": [{ "array_list_get": 0 }], "expect_null": true },
    { "op": "iterator", "on": "root", "as": "it" },
    { "op": "next", "on": "it", "expect_null": true, "note": "nothing at all" },

    { "op": "create_database", "name": "last", "file_id": "0000000000000003" },
    { "op": "use", "name": "last" },
    { "op": "close" },
    { "op": "raw_load", "input": "v1-unwritten-last", "note": "moments 1, 2 and 3, and a fourth never written" },
    { "op": "reopen" },
    { "op": "count", "on": "root", "expect": 4 },
    { "op": "read_path_slot", "on": "root", "path": [{ "array_list_get": -1 }], "expect_null": true },
    { "op": "iterator", "on": "root", "from_index": 2, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 3 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "write_path", "on": "root", "path": ["array_list_init", { "array_list_get": -1 }, { "write": { "uint": 4 } }], "note": "written now, it's a moment, and the file stays version 1" },
    { "op": "iterator", "on": "root", "from_index": 3, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 4 },
    { "op": "next", "on": "it", "expect_null": true }
  ]
}
