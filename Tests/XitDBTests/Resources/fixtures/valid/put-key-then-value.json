    { "op": "read_path", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"key": {"sha1": "a new key, too long for a slot"}}}], "as": "k" },
    { "op": "read_bytes", "on": "k", "expect": "a new key, too long for a slot" },
    { "op": "read_path", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"value": {"sha1": "a new key, too long for a slot"}}}], "as": "v" },
    { "op": "read_bytes", "on": "v", "expect": "new" },
    { "op": "read_path_slot", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "counted"}}}, {"hash_map_get": {"key": {"sha1": "short"}}}], "expect": {"tag": "short_bytes"} },
    { "op": "read_path", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "counted"}}}, {"hash_map_get": {"key": {"sha1": "short"}}}], "as": "k" },
