{
  "format": "xitdb-script/1",
  "description": "What HashMap.putKey and then put write, under one hash and in one transaction, in a hash map and a counted hash map. putKey is a write path to the entry's key with a callback that does write_if_empty, as the original has it, and put is a write path to its value with a write. The first transaction makes entries with a key that sits in its slot and one with a record of its own, and two with a value alone. The second does the same pair again on the entries that have their keys, which writes no key, on the two that have none, and on a new entry.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "c0f00000000000b1",
  "ops": [
    { "op": "run_context", "ctx": { "as": "c", "ops": [
      { "op": "write_path", "on": "c", "path": [{"hash_map_init": {}}], "as": "top" },
      { "op": "write_path", "on": "top", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_init": {}}], "as": "plain" },
      { "op": "write_path", "on": "top", "path": [{"hash_map_get": {"value": {"sha1": "counted"}}}, {"hash_map_init": {"counted": true}}], "as": "counted" },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"key": {"sha1": "short"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "short"}}]}}], "note": "putKey: a new entry, and a key that sits in its slot" },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"value": {"sha1": "short"}}}, {"write": {"bytes": "one"}}], "note": "then put, under the same hash" },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"key": {"sha1": "a key too long for a slot"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "a key too long for a slot"}}]}}], "note": "a key with a record of its own" },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"value": {"sha1": "a key too long for a slot"}}}, {"write": {"bytes": "the long key's first value"}}] },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"value": {"sha1": "alone"}}}, {"write": {"uint": 1}}], "note": "a value alone, and no key" },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"value": {"sha1": "alone, with a key too long for a slot"}}}, {"write": {"uint": 2}}] },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"key": {"sha1": "short"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "short"}}]}}], "note": "putKey: a new entry, and a key that sits in its slot" },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"value": {"sha1": "short"}}}, {"write": {"bytes": "one"}}], "note": "then put, under the same hash" },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"key": {"sha1": "a key too long for a slot"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "a key too long for a slot"}}]}}], "note": "a key with a record of its own" },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"value": {"sha1": "a key too long for a slot"}}}, {"write": {"bytes": "the long key's first value"}}] },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"value": {"sha1": "alone"}}}, {"write": {"uint": 1}}], "note": "a value alone, and no key" },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"value": {"sha1": "alone, with a key too long for a slot"}}}, {"write": {"uint": 2}}] },
      { "op": "count", "on": "counted", "expect": 4, "note": "each new entry counts once, at the first hash_map_get that makes it" }
    ] }, "note": "the first transaction" },
    { "op": "read_path_slot", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"key": {"sha1": "alone"}}}], "expect_null": true, "note": "the entries given a value alone have no key: their key slots are empty, which reads as null, as a missing entry does" },
    { "op": "read_path_slot", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "counted"}}}, {"hash_map_get": {"key": {"sha1": "alone"}}}], "expect_null": true, "note": "the entries given a value alone have no key: their key slots are empty, which reads as null, as a missing entry does" },
    { "op": "run_context", "ctx": { "as": "c", "ops": [
      { "op": "write_path", "on": "c", "path": [{"hash_map_init": {}}], "as": "top" },
      { "op": "write_path", "on": "top", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_init": {}}], "as": "plain" },
