      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"key": {"sha1": "short"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "short"}}]}}], "note": "an entry from the first transaction that has its key, so write_if_empty writes nothing" },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"value": {"sha1": "short"}}}, {"write": {"bytes": "two"}}] },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"key": {"sha1": "a key too long for a slot"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "a key too long for a slot"}}]}}], "note": "the same with a key in a record, which would be a new record if it were written again" },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"value": {"sha1": "a key too long for a slot"}}}, {"write": {"bytes": "the long key's second value"}}] },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"key": {"sha1": "alone"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "alone"}}]}}], "note": "an entry from the first transaction with no key, which gets one" },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"value": {"sha1": "alone"}}}, {"write": {"uint": 3}}] },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"key": {"sha1": "alone, with a key too long for a slot"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "alone, with a key too long for a slot"}}]}}] },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"value": {"sha1": "alone, with a key too long for a slot"}}}, {"write": {"uint": 4}}] },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"key": {"sha1": "a new key, too long for a slot"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "a new key, too long for a slot"}}]}}], "note": "and a new entry" },
      { "op": "write_path", "on": "plain", "path": [{"hash_map_get": {"value": {"sha1": "a new key, too long for a slot"}}}, {"write": {"bytes": "new"}}] },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"key": {"sha1": "short"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "short"}}]}}], "note": "an entry from the first transaction that has its key, so write_if_empty writes nothing" },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"value": {"sha1": "short"}}}, {"write": {"bytes": "two"}}] },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"key": {"sha1": "a key too long for a slot"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "a key too long for a slot"}}]}}], "note": "the same with a key in a record, which would be a new record if it were written again" },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"value": {"sha1": "a key too long for a slot"}}}, {"write": {"bytes": "the long key's second value"}}] },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"key": {"sha1": "alone"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "alone"}}]}}], "note": "an entry from the first transaction with no key, which gets one" },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"value": {"sha1": "alone"}}}, {"write": {"uint": 3}}] },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"key": {"sha1": "alone, with a key too long for a slot"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "alone, with a key too long for a slot"}}]}}] },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"value": {"sha1": "alone, with a key too long for a slot"}}}, {"write": {"uint": 4}}] },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"key": {"sha1": "a new key, too long for a slot"}}}, {"ctx": {"as": "k", "ops": [{"op": "write_if_empty", "on": "k", "data": {"bytes": "a new key, too long for a slot"}}]}}], "note": "and a new entry" },
      { "op": "write_path", "on": "counted", "path": [{"hash_map_get": {"value": {"sha1": "a new key, too long for a slot"}}}, {"write": {"bytes": "new"}}] },
      { "op": "count", "on": "counted", "expect": 5 }
    ] }, "note": "the second transaction, on what the first one committed" },
    { "op": "read_path_slot", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"key": {"sha1": "short"}}}], "expect": {"tag": "short_bytes"} },
    { "op": "read_path", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"key": {"sha1": "short"}}}], "as": "k" },
    { "op": "read_bytes", "on": "k", "expect": "short" },
    { "op": "read_path", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"value": {"sha1": "short"}}}], "as": "v" },
    { "op": "read_bytes", "on": "v", "expect": "two" },
    { "op": "read_path_slot", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"key": {"sha1": "a key too long for a slot"}}}], "expect": {"tag": "bytes"} },
    { "op": "read_path", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"key": {"sha1": "a key too long for a slot"}}}], "as": "k" },
    { "op": "read_bytes", "on": "k", "expect": "a key too long for a slot" },
    { "op": "read_path", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"value": {"sha1": "a key too long for a slot"}}}], "as": "v" },
    { "op": "read_bytes", "on": "v", "expect": "the long key's second value" },
    { "op": "read_path_slot", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"key": {"sha1": "alone"}}}], "expect": {"tag": "short_bytes"} },
    { "op": "read_path", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"key": {"sha1": "alone"}}}], "as": "k" },
    { "op": "read_bytes", "on": "k", "expect": "alone" },
    { "op": "read_path", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"value": {"sha1": "alone"}}}], "as": "v" },
    { "op": "read_uint", "on": "v", "expect": 3 },
    { "op": "read_path_slot", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"key": {"sha1": "alone, with a key too long for a slot"}}}], "expect": {"tag": "bytes"} },
    { "op": "read_path", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"key": {"sha1": "alone, with a key too long for a slot"}}}], "as": "k" },
    { "op": "read_bytes", "on": "k", "expect": "alone, with a key too long for a slot" },
    { "op": "read_path", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "plain"}}}, {"hash_map_get": {"value": {"sha1": "alone, with a key too long for a slot"}}}], "as": "v" },
    { "op": "read_uint", "on": "v", "expect": 4 },
