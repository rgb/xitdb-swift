{
  "format": "xitdb-script/1",
  "description": "Iterators on a linked array list: what they give, where they start, and what they raise. An element appended and never written is marked as written with nothing, so unlike in an array list, it isn't skipped.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "0011223344556677",
  "ops": [
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "linked_array_list_init", "linked_array_list_append", { "write": { "uint": 10 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "linked_array_list_init", "linked_array_list_append", { "write": { "uint": 30 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "linked_array_list_init", { "linked_array_list_insert": 1 }, { "write": { "uint": 20 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "empty_list" } } }, "linked_array_list_init"] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "holes" } } }, "linked_array_list_init", "linked_array_list_append"] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "holes" } } }, "linked_array_list_init", "linked_array_list_append", { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "holes" } } }, "linked_array_list_init", "linked_array_list_append", { "write": { "slot": null } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sliced" } } }, "linked_array_list_init", "linked_array_list_append"] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sliced" } } }, "linked_array_list_init", "linked_array_list_append", { "write": { "uint": 1 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sliced" } } }, "linked_array_list_init", "linked_array_list_append", { "write": { "uint": 2 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sliced" } } }, "linked_array_list_init", { "linked_array_list_slice": { "offset": 0, "size": 2 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "number" } } }, { "write": { "uint": 5 } }] }
    ] } }] },

    { "op": "read_path", "on": "root", "path": [{ "array_list_get": -1 }], "as": "moment" },
    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }], "as": "list" },
    { "op": "slot", "on": "list", "expect": { "tag": "linked_array_list" } },
    { "op": "iterator", "on": "list", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 10 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 20 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 30 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "list", "from_index": 1, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 20 },
    { "op": "iterator", "on": "list", "from_index": -1, "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 30 },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "list", "from_index": 3, "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "list", "from_index": -4, "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "list", "from_key": "a", "as": "not_this", "expect_error": "UnexpectedTag" },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "empty_list" } } }], "as": "empty_list" },
    { "op": "iterator", "on": "empty_list", "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },
    { "op": "iterator", "on": "empty_list", "from_index": 0, "as": "it" },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "holes" } } }], "as": "holes" },
    { "op": "iterator", "on": "holes", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false, "note": "never written" },
    { "op": "slot", "on": "e", "expect": { "tag": "none", "full": true } },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 1 },
    { "op": "next", "on": "it", "as": "e", "expect_null": false, "note": "written with nothing, which looks the same" },
    { "op": "slot", "on": "e", "expect": { "tag": "none", "full": true } },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "sliced" } } }], "as": "sliced", "note": "so a sliced list can't give anything past its end" },
    { "op": "count", "on": "sliced", "expect": 2 },
    { "op": "iterator", "on": "sliced", "as": "it" },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "slot", "on": "e", "expect": { "tag": "none", "full": true } },
    { "op": "next", "on": "it", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 1 },
    { "op": "next", "on": "it", "expect_null": true },

    { "op": "read_path", "on": "moment", "path": [{ "hash_map_get": { "value": { "sha1": "number" } } }], "as": "number" },
    { "op": "iterator", "on": "number", "from_index": 0, "as": "not_this", "expect_error": "UnexpectedTag" },

    { "op": "iterator", "on": "list", "as": "kept" },
    { "op": "next", "on": "kept", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 10 },
    { "op": "read_path_slot", "on": "root", "path": [{ "array_list_get": -1 }], "as": "last" },
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "write": { "slot": { "var": "last" } } }, { "hash_map_init": {} }, { "ctx": { "as": "m", "ops": [
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "linked_array_list_init", { "linked_array_list_remove": 1 }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "linked_array_list_init", "linked_array_list_append", { "write": { "uint": 40 } }] },
      { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "list" } } }, "linked_array_list_init"], "as": "new_list" },
      { "op": "next", "on": "kept", "as": "e", "expect_null": false, "note": "this iterator's transaction is over, and the write above copied what it reads" },
      { "op": "read_uint", "on": "e", "expect": 20 },
      { "op": "iterator", "on": "new_list", "as": "it", "note": "this one sees the transaction" },
      { "op": "next", "on": "it", "as": "e", "expect_null": false },
      { "op": "read_uint", "on": "e", "expect": 10 },
      { "op": "next", "on": "it", "as": "e", "expect_null": false },
      { "op": "read_uint", "on": "e", "expect": 30 },
      { "op": "next", "on": "it", "as": "e", "expect_null": false },
      { "op": "read_uint", "on": "e", "expect": 40 },
      { "op": "next", "on": "it", "expect_null": true }
    ] } }] },
    { "op": "next", "on": "kept", "as": "e", "expect_null": false },
    { "op": "read_uint", "on": "e", "expect": 30 },
    { "op": "next", "on": "kept", "expect_null": true }
  ]
}
