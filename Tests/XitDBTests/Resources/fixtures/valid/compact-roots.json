    {"op": "compact", "into": "t_tagged_short", "file_id": "0000000000000021", "offset_map": "memory"},
    {"op": "use", "name": "t_tagged_short"},
    {"op": "read_bytes", "on": "root", "expect": "abc", "expect_format_tag": "xy"},
    {"op": "create_database", "name": "s_empty_list", "file_id": "0000000000000022"},
    {"op": "use", "name": "s_empty_list"},
    {"op": "write_path", "on": "root", "path": ["array_list_init"]},
    {"op": "compact", "into": "t_empty_list", "file_id": "0000000000000023", "offset_map": "memory", "note": "a history with no moments has no last moment, so the target is empty and not an empty list"},
    {"op": "use", "name": "t_empty_list"},
    {"op": "committed_size", "expect": 62},
    {"op": "slot", "on": "root", "expect": {"tag": "none", "full": false}},
    {"op": "create_database", "name": "s_unwritten_last", "file_id": "0000000000000024"},
    {"op": "use", "name": "s_unwritten_last"},
    {"op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append"]},
    {"op": "compact", "into": "t_unwritten_last", "file_id": "0000000000000025", "offset_map": "memory", "note": "a last moment that was never written is the same as none"},
    {"op": "use", "name": "t_unwritten_last"},
    {"op": "committed_size", "expect": 62},
    {"op": "slot", "on": "root", "expect": {"tag": "none", "full": false}},
    {"op": "create_database", "name": "s_cleared_last", "file_id": "0000000000000026"},
