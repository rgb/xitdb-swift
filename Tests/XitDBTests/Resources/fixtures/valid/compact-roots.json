    {"op": "use", "name": "t_cleared_last"},
    {"op": "count", "on": "root", "expect": 1},
    {"op": "read_path_slot", "on": "root", "path": [{"array_list_get": 0}], "expect": {"tag": "none", "full": true}},
    {"op": "create_database", "name": "s_map", "file_id": "0000000000000028"},
    {"op": "use", "name": "s_map"},
    {"op": "write_path", "on": "root", "path": [{"hash_map_init": {}}, {"hash_map_get": {"value": {"sha1": "a"}}}, {"write": {"uint": 1}}]},
    {"op": "write_path", "on": "root", "path": [{"hash_map_init": {}}, {"hash_map_get": {"value": {"sha1": "b"}}}, {"write": {"bytes": "a long value in a map"}}]},
    {"op": "compact", "into": "t_map", "file_id": "0000000000000029", "offset_map": "memory", "note": "any other root is written whole"},
    {"op": "use", "name": "t_map"},
    {"op": "read_path", "on": "root", "path": [{"hash_map_get": {"value": {"sha1": "b"}}}], "as": "v"},
    {"op": "read_bytes", "on": "v", "expect": "a long value in a map"},
    {"op": "create_database", "name": "s_counted", "file_id": "000000000000002a"},
    {"op": "use", "name": "s_counted"},
    {"op": "write_path", "on": "root", "path": [{"hash_map_init": {"counted": true}}, {"hash_map_get": {"value": {"sha1": "a"}}}, {"write": {"uint": 1}}]},
    {"op": "write_path", "on": "root", "path": [{"hash_map_init": {"counted": true}}, {"hash_map_get": {"value": {"sha1": "b"}}}, {"write": {"uint": 2}}]},
    {"op": "compact", "into": "t_counted", "file_id": "000000000000002b", "offset_map": "memory"},
    {"op": "use", "name": "t_counted"},
    {"op": "count", "on": "root", "expect": 2},
    {"op": "create_database", "name": "s_set", "file_id": "000000000000002c"},
    {"op": "use", "name": "s_set"},
    {"op": "write_path", "on": "root", "path": [{"hash_map_init": {"set": true}}, {"hash_map_get": {"key": {"sha1": "a"}}}, {"write": {"bytes": "a"}}]},
    {"op": "compact", "into": "t_set", "file_id": "000000000000002d", "offset_map": "memory"},
    {"op": "use", "name": "t_set"},
    {"op": "slot", "on": "root", "expect": {"tag": "hash_set"}},
    {"op": "create_database", "name": "s_counted_set", "file_id": "000000000000002e"},
    {"op": "use", "name": "s_counted_set"},
    {"op": "write_path", "on": "root", "path": [{"hash_map_init": {"counted": true, "set": true}}, {"hash_map_get": {"key": {"sha1": "a"}}}, {"write": {"bytes": "a"}}]},
    {"op": "compact", "into": "t_counted_set", "file_id": "000000000000002f", "offset_map": "memory"},
    {"op": "use", "name": "t_counted_set"},
    {"op": "count", "on": "root", "expect": 1},
    {"op": "slot", "on": "root", "expect": {"tag": "counted_hash_set"}},
    {"op": "create_database", "name": "s_sorted", "file_id": "0000000000000030"},
    {"op": "use", "name": "s_sorted"},
    {"op": "write_path", "on": "root", "path": [{"sorted_map_init": {}}, {"sorted_map_get": {"value": "b"}}, {"write": {"uint": 2}}]},
    {"op": "write_path", "on": "root", "path": [{"sorted_map_init": {}}, {"sorted_map_get": {"value": "a"}}, {"write": {"uint": 1}}]},
    {"op": "compact", "into": "t_sorted", "file_id": "0000000000000031", "offset_map": "memory"},
    {"op": "use", "name": "t_sorted"},
    {"op": "rank", "on": "root", "key": "b", "expect": 1},
    {"op": "read_path", "on": "root", "path": [{"sorted_map_get": {"value": "a"}}], "as": "v"},
    {"op": "read_uint", "on": "v", "expect": 1},
    {"op": "create_database", "name": "s_sorted_set", "file_id": "0000000000000032"},
    {"op": "use", "name": "s_sorted_set"},
    {"op": "write_path", "on": "root", "path": [{"sorted_map_init": {"set": true}}, {"sorted_map_get": {"key": "b"}}]},
    {"op": "write_path", "on": "root", "path": [{"sorted_map_init": {"set": true}}, {"sorted_map_get": {"key": "a"}}]},
    {"op": "compact", "into": "t_sorted_set", "file_id": "0000000000000033", "offset_map": "memory"},
    {"op": "use", "name": "t_sorted_set"},
    {"op": "rank", "on": "root", "key": "b", "expect": 1},
    {"op": "slot", "on": "root", "expect": {"tag": "sorted_set"}},
    {"op": "create_database", "name": "s_linked", "file_id": "0000000000000034"},
    {"op": "use", "name": "s_linked"},
    {"op": "write_path", "on": "root", "path": ["linked_array_list_init", "linked_array_list_append", {"write": {"uint": 1}}]},
    {"op": "write_path", "on": "root", "path": ["linked_array_list_init", {"linked_array_list_insert": 0}, {"write": {"uint": 0}}]},
    {"op": "compact", "into": "t_linked", "file_id": "0000000000000035", "offset_map": "memory"},
    {"op": "use", "name": "t_linked"},
    {"op": "count", "on": "root", "expect": 2},
    {"op": "read_path", "on": "root", "path": [{"linked_array_list_get": 1}], "as": "v"},
    {"op": "read_uint", "on": "v", "expect": 1}
  ]
}
