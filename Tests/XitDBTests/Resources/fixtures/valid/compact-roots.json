{
  "format": "xitdb-script/1",
  "description": "Compacting each kind of root. A list at the root is a history, and only its last moment survives. Anything else is written whole, and a root with nothing in it gives a new database with no commit.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "0011223344556677",
  "ops": [
    {"op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", {"write": {"uint": 1}}]},
    {"op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", {"write": {"uint": 2}}]},
    {"op": "compact", "into": "t_history", "file_id": "00000000000000f0", "offset_map": "memory", "note": "a list at the root is a history, and only its last moment survives"},
    {"op": "use", "name": "t_history"},
    {"op": "count", "on": "root", "expect": 1},
    {"op": "read_path", "on": "root", "path": [{"array_list_get": 0}], "as": "v"},
    {"op": "read_uint", "on": "v", "expect": 2},
    {"op": "create_database", "name": "s_empty", "file_id": "0000000000000010"},
    {"op": "use", "name": "s_empty"},
    {"op": "compact", "into": "t_empty", "file_id": "0000000000000011", "offset_map": "memory", "note": "nothing to do, and no commit"},
    {"op": "use", "name": "t_empty"},
    {"op": "committed_size", "expect": 62},
    {"op": "slot", "on": "root", "expect": {"tag": "none", "full": false}},
    {"op": "create_database", "name": "s_cleared", "file_id": "0000000000000012"},
    {"op": "use", "name": "s_cleared"},
    {"op": "write", "on": "root", "data": {"slot": null}},
    {"op": "compact", "into": "t_cleared", "file_id": "0000000000000013", "offset_map": "memory", "note": "set to nothing is not empty, so it is written"},
    {"op": "use", "name": "t_cleared"},
    {"op": "slot", "on": "root", "expect": {"tag": "none", "full": true}},
    {"op": "create_database", "name": "s_uint", "file_id": "0000000000000014"},
    {"op": "use", "name": "s_uint"},
    {"op": "write", "on": "root", "data": {"uint": 42}},
    {"op": "compact", "into": "t_uint", "file_id": "0000000000000015", "offset_map": "memory"},
    {"op": "use", "name": "t_uint"},
    {"op": "read_uint", "on": "root", "expect": 42},
    {"op": "create_database", "name": "s_int", "file_id": "0000000000000016"},
    {"op": "use", "name": "s_int"},
    {"op": "write", "on": "root", "data": {"int": -42}},
    {"op": "compact", "into": "t_int", "file_id": "0000000000000017", "offset_map": "memory"},
    {"op": "use", "name": "t_int"},
    {"op": "read_int", "on": "root", "expect": -42},
    {"op": "create_database", "name": "s_float", "file_id": "0000000000000018"},
    {"op": "use", "name": "s_float"},
    {"op": "write", "on": "root", "data": {"float": "40091eb851eb851f"}},
    {"op": "compact", "into": "t_float", "file_id": "0000000000000019", "offset_map": "memory"},
    {"op": "use", "name": "t_float"},
    {"op": "read_float", "on": "root", "expect": "40091eb851eb851f"},
    {"op": "create_database", "name": "s_short", "file_id": "000000000000001a"},
    {"op": "use", "name": "s_short"},
    {"op": "write", "on": "root", "data": {"bytes": "hi"}},
    {"op": "compact", "into": "t_short", "file_id": "000000000000001b", "offset_map": "memory"},
    {"op": "use", "name": "t_short"},
    {"op": "read_bytes", "on": "root", "expect": "hi"},
    {"op": "create_database", "name": "s_long", "file_id": "000000000000001c"},
    {"op": "use", "name": "s_long"},
    {"op": "write", "on": "root", "data": {"bytes": "a long value at the root"}},
    {"op": "compact", "into": "t_long", "file_id": "000000000000001d", "offset_map": "memory"},
    {"op": "use", "name": "t_long"},
    {"op": "read_bytes", "on": "root", "expect": "a long value at the root"},
    {"op": "create_database", "name": "s_tagged", "file_id": "000000000000001e"},
    {"op": "use", "name": "s_tagged"},
    {"op": "write", "on": "root", "data": {"bytes_object": {"value": "a long tagged value at the root", "format_tag": "ab"}}},
    {"op": "compact", "into": "t_tagged", "file_id": "000000000000001f", "offset_map": "memory"},
    {"op": "use", "name": "t_tagged"},
    {"op": "read_bytes", "on": "root", "expect": "a long tagged value at the root", "expect_format_tag": "ab"},
    {"op": "create_database", "name": "s_tagged_short", "file_id": "0000000000000020"},
    {"op": "use", "name": "s_tagged_short"},
