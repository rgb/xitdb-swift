{
  "format": "xitdb-script/1",
  "description": "A sync at 0 replaces the database, starting by emptying it, so if it fails, there's no database left until one succeeds. Which error it raises depends on how far it got. This is what Zig does, and the README tells a caller who cares to copy to a new file instead. It's different from an append, which leaves the replica as it was (replicate-interrupted).",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "0000000000000001",
  "ops": [
    { "op": "create_database", "name": "replica", "file_id": "0000000000000002" },
    { "op": "write", "on": "root", "data": { "uint": 1 } },
    { "op": "read_committed", "start": 0, "end": 96, "as": "sent" },
    { "op": "use", "name": "replica" },

    { "op": "apply_replicated", "start": 0, "bytes": "sent", "short_by": 1, "expect_error": "TruncatedDatabase", "note": "the root header says more than there is" },
    { "op": "committed_size", "expect_error": "TruncatedDatabase" },
    { "op": "replica_state", "as": "state", "expect_error": "TruncatedDatabase" },
    { "op": "apply_replicated", "start": 95, "bytes": "sent", "expect_error": "TruncatedDatabase", "note": "and it can't be added to, as it can't say where its committed bytes end" },

    { "op": "apply_replicated", "start": 0, "bytes": "sent", "short_by": 86, "expect_error": "EndOfStream", "note": "not even the whole header" },
    { "op": "committed_size", "expect_error": "EndOfStream" },
    { "op": "apply_replicated", "start": 0, "bytes": "sent", "short_by": 96, "expect_error": "EndOfStream", "note": "or nothing" },
    { "op": "committed_size", "expect_error": "EndOfStream" },

    { "op": "apply_replicated", "start": 0, "bytes": "sent", "note": "and a whole one puts it right" },
    { "op": "committed_size", "expect": 96 },
    { "op": "read_uint", "on": "root", "expect": 1 },
    { "op": "read_committed", "start": 0, "end": 96, "as": "got", "expect_same": "sent" },
    { "op": "replica_state", "as": "state" },
    { "op": "use", "name": "main" },
    { "op": "replication_start", "state": "state", "expect": 96 },

    { "op": "create_database", "name": "left_broken", "file_id": "0000000000000003" },
    { "op": "use", "name": "left_broken" },
    { "op": "apply_replicated", "start": 0, "bytes": "sent", "short_by": 1, "expect_error": "TruncatedDatabase" },
    { "op": "close" },
    { "op": "reopen", "expect_error": "TruncatedDatabase", "note": "it can't be opened either, and here it stays" }
  ]
}
