{
  "format": "xitdb-script/1",
  "description": "Each way a file can fail to open, with what the port does. A root header that can't be trusted raises UntrustedRootHeader, where Zig raises InvalidDatabase or TruncatedDatabase, and nothing is dropped until recover is called. That ends the file at the last trailer that verifies, says so in the root header, and opens it. A bad magic number isn't a database, and stays what it is.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "c0f0000000000017",
  "ops": [
    {"op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", {"hash_map_init": {}}, {"ctx": {"as": "m", "ops": [{"op": "write_path", "on": "m", "path": [{"hash_map_get": {"value": {"sha1": "a"}}}, {"write": {"uint": 1}}]}, {"op": "write_path", "on": "m", "path": [{"hash_map_get": {"value": {"sha1": "long"}}}, {"write": {"bytes": "a value too long to fit in a slot"}}]}]}}]},
    {"op": "close"},
    {"op": "raw_write", "offset": 0, "bytes": {"hex": "7a"}, "note": "the magic number"},
    {"op": "reopen", "expect_error": "InvalidDatabase"},
    {"op": "raw_write", "offset": 0, "bytes": {"hex": "78"}},
    {"op": "raw_write", "offset": 4, "bytes": {"hex": "0002"}, "note": "the version"},
    {"op": "reopen", "expect_error": "InvalidVersion"},
    {"op": "raw_write", "offset": 4, "bytes": {"hex": "0001"}},
    {"op": "raw_write", "offset": 6, "bytes": {"hex": "0008"}, "note": "the hash size"},
    {"op": "reopen", "expect_error": "InvalidHashSize"},
    {"op": "raw_write", "offset": 6, "bytes": {"hex": "0014"}},
    {"op": "raw_write", "offset": 29, "bytes": {"hex": "000000000000000a"}, "note": "a committed size smaller than a new database"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "raw_write", "offset": 29, "bytes": {"hex": "0000000000000205"}},
    {"op": "raw_write", "offset": 29, "bytes": {"hex": "0000000000000206"}, "note": "a committed size past the end of the file"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "raw_write", "offset": 29, "bytes": {"hex": "0000000000000205"}},
    {"op": "raw_write", "offset": 29, "bytes": {"hex": "0000000000000204"}, "note": "a committed size that doesn't end at a trailer, whose checksum then fails"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "raw_write", "offset": 29, "bytes": {"hex": "0000000000000205"}},
    {"op": "raw_write", "offset": 492, "bytes": {"hex": "ff0000000000000047"}, "note": "a changed root slot in the last trailer, whose checksum then fails"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "raw_write", "offset": 492, "bytes": {"hex": "020000000000000047"}},
    {"op": "reopen", "hash_size": 8, "expect_error": "InvalidHashSize", "note": "a file that's fine, opened with another hash size"},
    {"op": "reopen", "hash_size": 64, "expect_error": "InvalidHashSize"},
    {"op": "reopen", "hash_size": 20, "note": "stating the file's own size is the same as not stating it"},
    {"op": "count", "on": "root", "expect": 1},
    {"op": "read_path", "on": "root", "path": [{"array_list_get": -1}, {"hash_map_get": {"value": {"sha1": "a"}}}], "as": "c"},
    {"op": "read_uint", "on": "c", "expect": 1},

    {"op": "close"},
    {"op": "raw_write", "offset": 0, "bytes": {"hex": "7a"}, "note": "a bad magic number can't be recovered from, as this isn't a database"},
    {"op": "recover", "expect_error": "InvalidDatabase"},
    {"op": "raw_write", "offset": 0, "bytes": {"hex": "78"}},

    {"op": "raw_write", "offset": 29, "bytes": {"hex": "0000000000000206"}, "note": "a committed size past the end of the file, and the last trailer that verifies is the last commit"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "recover"},
    {"op": "committed_size", "expect": 517},
    {"op": "read_path", "on": "root", "path": [{"array_list_get": -1}, {"hash_map_get": {"value": {"sha1": "a"}}}], "as": "c"},
    {"op": "read_uint", "on": "c", "expect": 1},
    {"op": "close"},

    {"op": "raw_write", "offset": 29, "bytes": {"hex": "000000000000000a"}, "note": "a committed size smaller than a new database, with what a crash left, which recovering drops"},
    {"op": "raw_append", "bytes": "what a crash left"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "recover"},
    {"op": "committed_size", "expect": 517},
    {"op": "read_path", "on": "root", "path": [{"array_list_get": -1}, {"hash_map_get": {"value": {"sha1": "a"}}}], "as": "c"},
    {"op": "read_uint", "on": "c", "expect": 1},
    {"op": "close"},

    {"op": "raw_write", "offset": 492, "bytes": {"hex": "ff0000000000000047"}, "note": "a changed root slot in the last trailer, so the last commit is lost, by this call and no other way"},
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "recover"},
    {"op": "committed_size", "expect": 62},
    {"op": "read_path", "on": "root", "path": [], "expect_null": true},

    {"op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", {"hash_map_init": {}}, {"hash_map_get": {"value": {"sha1": "b"}}}, {"write": {"uint": 2}}], "note": "and it goes on from there"},
    {"op": "count", "on": "root", "expect": 1},
    {"op": "read_path", "on": "root", "path": [{"array_list_get": -1}, {"hash_map_get": {"value": {"sha1": "b"}}}], "as": "c"},
    {"op": "read_uint", "on": "c", "expect": 2}
  ]
}
