{
  "format": "xitdb-script/1",
  "description": "A database whose trailer doesn't match its root header can't be opened, which goes for a replica too, with what the port does: it raises UntrustedRootHeader, and recover goes back to the last trailer that verifies. The other databases carry on.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "0000000000000001",
  "ops": [
    { "op": "create_database", "name": "replica", "file_id": "0000000000000002" },
    { "op": "write", "on": "root", "data": { "uint": 1 } },
    { "op": "read_committed", "start": 0, "end": 91, "as": "sent" },
    { "op": "use", "name": "replica" },
    { "op": "apply_replicated", "start": 0, "bytes": "sent" },
    { "op": "close" },
    { "op": "raw_write", "offset": 75, "bytes": { "hex": "00000000000000000000000000000000" }, "note": "the commit ID and checksum of the trailer at 66" },
    {"op": "reopen", "expect_error": "UntrustedRootHeader"},
    {"op": "recover"},
    {"op": "committed_size", "expect": 57},
    {"op": "read_path", "on": "root", "path": [], "expect_null": true},
    { "op": "use", "name": "main" },
    { "op": "read_uint", "on": "root", "expect": 1 },
    { "op": "write", "on": "root", "data": { "uint": 2 } }
  ]
}
