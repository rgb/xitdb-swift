{
  "format": "xitdb-script/1",
  "description": "The part of every-construct that needs sorted maps and sets.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "c0f0000000000008",
  "ops": [
    { "op": "write_path", "on": "root", "path": [
      "array_list_init",
      "array_list_append",
      { "hash_map_init": {} },
      { "ctx": { "as": "m", "ops": [
        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sorted" } } }, { "sorted_map_init": {} }], "as": "sm" },
        { "op": "write_path", "on": "sm", "path": [{ "sorted_map_get": { "value": { "hex": "00ff" } } }, { "write": { "uint": 1 } }], "note": "a key with a zero byte can't be short" },
        { "op": "write_path", "on": "sm", "path": [{ "sorted_map_get": { "value": "a key longer than a slot" } }, { "write": { "uint": 2 } }] },
        { "op": "write_path", "on": "sm", "path": [{ "sorted_map_get": { "kv_pair": "b" } }], "as": "pair" },
        { "op": "read_key_value_pair", "on": "pair", "key_as": "k", "value_as": "v" },
        { "op": "slot", "on": "k", "expect": { "tag": "short_bytes" } },
        { "op": "write", "on": "k", "data": { "bytes": "b" },
          "note": "a sorted map's key can't be written through sorted_map_get {key}, but it can through a key-value pair. Writing a different key here would break the order" },
        { "op": "write", "on": "v", "data": { "uint": 3 } },
        { "op": "write_path", "on": "sm", "path": [{ "sorted_map_remove": "absent" }], "expect_error": "KeyNotFound" },
        { "op": "count", "on": "sm", "expect": 3 },
        { "op": "read_path", "on": "sm", "path": [{ "sorted_map_get_index": 0 }], "as": "first" },
        { "op": "read_key_value_pair", "on": "first", "key_as": "k" },
        { "op": "read_bytes", "on": "k", "expect": { "hex": "00ff" } },
        { "op": "read_path", "on": "sm", "path": [{ "sorted_map_get": { "key": "b" } }], "as": "k" },
        { "op": "read_bytes", "on": "k", "expect": "b" },
        { "op": "read_path", "on": "sm", "path": [{ "sorted_map_get_index": -1 }], "as": "last_entry" },
        { "op": "read_key_value_pair", "on": "last_entry", "value_as": "v" },
        { "op": "read_uint", "on": "v", "expect": 3 },
        { "op": "write_path", "on": "sm", "path": [{ "sorted_map_remove": { "hex": "00ff" } }] },
        { "op": "count", "on": "sm", "expect": 2 },

        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sorted-set" } } }, { "sorted_map_init": { "set": true } }], "as": "ss" },
        { "op": "write_path", "on": "ss", "path": [{ "sorted_map_get": { "key": "b" } }] },
        { "op": "write_path", "on": "ss", "path": [{ "sorted_map_get": { "key": "a" } }] },
        { "op": "write_path", "on": "ss", "path": [{ "sorted_map_get": { "key": "a" } }], "note": "already there, so not counted twice" },
        { "op": "count", "on": "ss", "expect": 2 },
        { "op": "read_path", "on": "ss", "path": [{ "sorted_map_get_index": 0 }], "as": "first" },
        { "op": "slot", "on": "first", "expect": { "tag": "short_bytes" }, "note": "a key in a set is stored directly in the leaf" },
        { "op": "read_key_value_pair", "on": "first", "key_as": "k", "value_as": "v" },
        { "op": "read_bytes", "on": "k", "expect": "a" },
        { "op": "slot", "on": "v", "expect": { "tag": "none", "full": false } },
        { "op": "write_path", "on": "ss", "path": [{ "sorted_map_get": { "key": "a" } }], "as": "k" },
        { "op": "write", "on": "k", "data": { "bytes": "a" }, "expect_error": "CursorNotWriteable", "note": "a key stored directly in a leaf has no slot of its own" },
        { "op": "write_path", "on": "ss", "path": [{ "sorted_map_get": { "kv_pair": "a" } }], "as": "pair", "note": "asking for a pair moves a key-only entry into one, even in a set" },
        { "op": "read_path", "on": "ss", "path": [{ "sorted_map_get_index": 0 }], "as": "first" },
        { "op": "slot", "on": "first", "expect": { "tag": "sorted_kv_pair" } },
        { "op": "read_key_value_pair", "on": "first", "key_as": "k" },
        { "op": "read_bytes", "on": "k", "expect": "a" },
        { "op": "write_path", "on": "ss", "path": [{ "sorted_map_remove": "b" }] },
        { "op": "count", "on": "ss", "expect": 1 },
        { "op": "slot", "on": "sm", "expect": { "tag": "sorted_map" } },
        { "op": "slot", "on": "ss", "expect": { "tag": "sorted_set" } },
        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "sorted-set-false" } } }, { "sorted_map_init": { "set": false } }], "as": "c" },
        { "op": "slot", "on": "c", "expect": { "tag": "sorted_map" } }
      ] } }
    ] }
  ]
}
