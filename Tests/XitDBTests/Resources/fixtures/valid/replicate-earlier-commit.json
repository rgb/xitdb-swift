{
  "format": "xitdb-script/1",
  "description": "Reading from 0 up to an earlier commit gives a complete database as of that commit, with the root header and root that it had then, whatever kind of root that was. It can catch up from there, one commit at a time or several together.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "0000000000000001",
  "ops": [
    { "op": "create_database", "name": "as_of_first", "file_id": "0000000000000002" },
    { "op": "create_database", "name": "as_of_second", "file_id": "0000000000000003" },
    { "op": "create_database", "name": "as_of_third", "file_id": "0000000000000004" },
    { "op": "create_database", "name": "as_of_nothing", "file_id": "0000000000000005" },

    { "op": "write", "on": "root", "data": { "uint": 1 } },
    { "op": "committed_size", "as": "first" },
    { "op": "write", "on": "root", "data": { "bytes": "a long value in the second root" } },
    { "op": "committed_size", "as": "second" },
    { "op": "write", "on": "root", "data": { "slot": null } },
    { "op": "committed_size", "as": "third" },
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "write": { "uint": 4 } }] },
    { "op": "committed_size", "as": "fourth" },
    { "op": "write_path", "on": "root", "path": ["array_list_init", "array_list_append", { "write": { "uint": 5 } }] },
    { "op": "committed_size", "as": "fifth" },

    { "op": "read_committed", "start": 0, "end": 62, "as": "bytes" },
    { "op": "use", "name": "as_of_nothing" },
    { "op": "apply_replicated", "start": 0, "bytes": "bytes" },
    { "op": "committed_size", "expect": 62 },
    { "op": "slot", "on": "root", "expect": { "tag": "none", "full": false }, "note": "the first commit of all, which has nothing in it" },

    { "op": "use", "name": "main" },
    { "op": "read_committed", "start": 0, "end": { "var": "first" }, "as": "bytes" },
    { "op": "use", "name": "as_of_first" },
    { "op": "apply_replicated", "start": 0, "bytes": "bytes" },
    { "op": "committed_size", "expect": { "var": "first" } },
    { "op": "read_uint", "on": "root", "expect": 1, "note": "the root as of that commit, and main's has moved on" },

    { "op": "use", "name": "main" },
    { "op": "read_committed", "start": 0, "end": { "var": "second" }, "as": "bytes" },
    { "op": "use", "name": "as_of_second" },
    { "op": "apply_replicated", "start": 0, "bytes": "bytes" },
    { "op": "committed_size", "expect": { "var": "second" } },
    { "op": "read_bytes", "on": "root", "expect": "a long value in the second root" },

    { "op": "use", "name": "main" },
    { "op": "read_committed", "start": 0, "end": { "var": "third" }, "as": "bytes" },
    { "op": "use", "name": "as_of_third" },
    { "op": "apply_replicated", "start": 0, "bytes": "bytes" },
    { "op": "committed_size", "expect": { "var": "third" } },
    { "op": "slot", "on": "root", "expect": { "tag": "none", "full": true }, "note": "set to nothing, which isn't the same as empty" },

    { "op": "use", "name": "as_of_first" },
    { "op": "replica_state", "as": "state" },
    { "op": "use", "name": "main" },
    { "op": "replication_start", "state": "state", "expect": { "var": "first" }, "note": "and it's a replica, which can catch up" },
    { "op": "read_committed", "start": { "var": "first" }, "end": { "var": "second" }, "as": "bytes" },
    { "op": "use", "name": "as_of_first" },
    { "op": "apply_replicated", "start": { "var": "first" }, "bytes": "bytes", "note": "one at a time" },
    { "op": "read_bytes", "on": "root", "expect": "a long value in the second root" },
    { "op": "use", "name": "main" },
    { "op": "read_committed", "start": { "var": "second" }, "end": { "var": "fifth" }, "as": "bytes" },
    { "op": "read_committed", "start": 0, "end": { "var": "fifth" }, "as": "all_of_main" },
    { "op": "use", "name": "as_of_first" },
    { "op": "apply_replicated", "start": { "var": "second" }, "bytes": "bytes", "note": "or three together" },
    { "op": "committed_size", "expect": { "var": "fifth" } },
    { "op": "count", "on": "root", "expect": 2 },
    { "op": "read_committed", "start": 0, "end": { "var": "fifth" }, "as": "got", "expect_same": "all_of_main" },

    { "op": "use", "name": "as_of_second" },
    { "op": "read_committed", "start": 0, "end": { "var": "first" }, "as": "bytes", "note": "a replica can do this too, for one of the commits it has" },
    { "op": "use", "name": "as_of_nothing" },
    { "op": "apply_replicated", "start": 0, "bytes": "bytes" },
    { "op": "read_uint", "on": "root", "expect": 1 },
    { "op": "committed_size", "expect": { "var": "first" } },

    { "op": "write", "on": "root", "data": { "uint": 6 }, "note": "and one as of an earlier commit can go its own way" },
    { "op": "replica_state", "as": "state" },
    { "op": "use", "name": "main" },
    { "op": "replication_start", "state": "state", "expect": 0, "note": "after which it isn't a replica of this any more" },

    { "op": "use", "name": "as_of_second" },
    { "op": "close" },
    { "op": "reopen", "note": "opening one goes by its root header, so it's as of that commit too" },
    { "op": "read_bytes", "on": "root", "expect": "a long value in the second root" },
    { "op": "use", "name": "as_of_third" },
    { "op": "close" },
    { "op": "reopen" },
    { "op": "slot", "on": "root", "expect": { "tag": "none", "full": true } }
  ]
}
