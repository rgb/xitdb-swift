{
  "format": "xitdb-script/1",
  "description": "A replica is never extended with bytes from a file it isn't a replica of, which is what test.zig's testReplicaOfOtherFile is about. The trailer's checksum covers the file ID and the commit ID, so a file of the same layout, a source restored from an older copy, and a copy of one file that went its own way all replace the replica rather than add to it.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "0000000000000001",
  "ops": [
    { "op": "create_database", "name": "other", "file_id": "0000000000000002" },
    { "op": "create_database", "name": "restored", "file_id": "0000000000000001", "note": "the same file ID as main, with its own history" },
    { "op": "create_database", "name": "replica", "file_id": "0000000000000003" },

    { "op": "write", "on": "root", "data": { "uint": 1 } },
    { "op": "use", "name": "other" },
    { "op": "write", "on": "root", "data": { "uint": 1 }, "note": "the same writes, so the same layout" },

    { "op": "use", "name": "replica" },
    { "op": "replica_state", "as": "state" },
    { "op": "use", "name": "main" },
    { "op": "replication_start", "state": "state", "as": "start", "expect": 0, "note": "a new database with its own file ID is replaced" },
    { "op": "committed_size", "as": "end", "expect": 96 },
    { "op": "read_committed", "start": { "var": "start" }, "end": { "var": "end" }, "as": "sent" },
    { "op": "use", "name": "replica" },
    { "op": "apply_replicated", "start": { "var": "start" }, "bytes": "sent" },
    { "op": "committed_size", "expect": 96 },
    { "op": "read_uint", "on": "root", "expect": 1 },
    { "op": "read_committed", "start": 0, "end": 96, "as": "got", "expect_same": "sent" },
    { "op": "replica_state", "as": "state" },

    { "op": "use", "name": "other" },
    { "op": "write", "on": "root", "data": { "uint": 2 } },
    { "op": "committed_size", "as": "other_end", "expect": 130 },
    { "op": "replication_start", "state": "state", "expect": 0, "note": "it has a trailer where the replica's bytes end, but its checksum covers another file ID" },
    { "op": "read_committed", "start": 96, "end": { "var": "other_end" }, "as": "from_other" },
    { "op": "use", "name": "replica" },
    { "op": "apply_replicated", "start": 96, "bytes": "from_other", "expect_error": "InvalidDatabase", "note": "and if they're sent anyway, they're rejected" },
    { "op": "committed_size", "expect": 96 },
    { "op": "read_uint", "on": "root", "expect": 1 },

    { "op": "use", "name": "restored" },
    { "op": "write", "on": "root", "data": { "uint": 3 } },
    { "op": "write", "on": "root", "data": { "uint": 4 } },
    { "op": "replication_start", "state": "state", "expect": 0, "note": "the same file ID, but every commit has a random ID, so its history differs" },

    { "op": "create_database", "name": "copy_a", "file_id": "0000000000000004" },
    { "op": "create_database", "name": "copy_b", "file_id": "0000000000000004" },
    { "op": "create_database", "name": "copy_replica", "file_id": "0000000000000005" },
    { "op": "use", "name": "copy_a" },
    { "op": "write", "on": "root", "data": { "bytes": "aaaaaaaaaaaa" } },
    { "op": "committed_size", "as": "copy_end" },
    { "op": "read_committed", "start": 0, "end": { "var": "copy_end" }, "as": "sent" },
    { "op": "use", "name": "copy_b" },
    { "op": "write", "on": "root", "data": { "bytes": "bbbbbbbbbbbb" } },
    { "op": "committed_size", "expect": { "var": "copy_end" }, "note": "two copies of one file, with different data of the same size" },
    { "op": "use", "name": "copy_replica" },
    { "op": "apply_replicated", "start": 0, "bytes": "sent" },
    { "op": "replica_state", "as": "copy_state" },
    { "op": "use", "name": "copy_b" },
    { "op": "replication_start", "state": "copy_state", "expect": 0 },
    { "op": "read_committed", "start": 0, "end": { "var": "copy_end" }, "as": "sent" },
    { "op": "use", "name": "copy_replica" },
    { "op": "apply_replicated", "start": 0, "bytes": "sent" },
    { "op": "read_bytes", "on": "root", "expect": "bbbbbbbbbbbb" },

    { "op": "use", "name": "main", "note": "while the real source only sends what's new" },
    { "op": "write", "on": "root", "data": { "uint": 2 } },
    { "op": "replication_start", "state": "state", "as": "start", "expect": 96 },
    { "op": "committed_size", "as": "end" },
    { "op": "read_committed", "start": { "var": "start" }, "end": { "var": "end" }, "as": "sent" },
    { "op": "read_committed", "start": 0, "end": { "var": "end" }, "as": "all_of_main" },
    { "op": "use", "name": "replica" },
    { "op": "apply_replicated", "start": { "var": "start" }, "bytes": "sent" },
    { "op": "read_committed", "start": 0, "end": { "var": "end" }, "as": "all_of_replica", "expect_same": "all_of_main" },
    { "op": "read_uint", "on": "root", "expect": 2 }
  ]
}
