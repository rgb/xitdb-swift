{
  "format": "xitdb-script/1",
  "description": "The corners of the path API that need sorted maps.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "c0f0000000000009",
  "ops": [
    { "op": "write_path", "on": "root", "path": [
      "array_list_init",
      "array_list_append",
      { "hash_map_init": {} },
      { "ctx": { "as": "m", "ops": [
        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "s" } } }, { "sorted_map_init": {} }, { "sorted_map_get": { "value": "a" } }, { "write": { "uint": 1 } }] },
        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "s" } } }, { "sorted_map_init": {} }, { "sorted_map_get_index": 0 }], "expect_error": "WriteNotAllowed",
          "note": "sorted_map_get_index is the one getter that only works in a read path" },
        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "s" } } }, { "sorted_map_init": {} }, { "sorted_map_remove": "a" }, { "ctx": { "as": "never", "ops": [{ "op": "fail" }] } }],
          "note": "the same for a sorted remove, even if the next part is a ctx: it doesn't run" },
        { "op": "write_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "s" } } }, { "sorted_map_init": {} }, { "sorted_map_get": { "key": "b" } }, { "write": { "uint": 1 } }], "expect_error": "CursorNotWriteable",
          "note": "a sorted key can't be written, but the failed path has already inserted it" },
        { "op": "read_path", "on": "m", "path": [{ "hash_map_get": { "value": { "sha1": "s" } } }], "as": "s" },
        { "op": "count", "on": "s", "expect": 1 }
      ] } }
    ] }
  ]
}
