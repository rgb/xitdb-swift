{
  "format": "xitdb-script/1",
  "description": "What can go wrong with a sync, apart from a first one. An append that stops short fails and leaves the replica as it was, and the next one writes over what it left. Bytes applied at the wrong place are refused, and so are ranges that don't make sense. A replica that's ahead of its source is replaced, so its committed size goes down, which isn't a commit. Reading from 0 up to an earlier commit gives a complete database as of that commit.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "0000000000000001",
  "ops": [
    { "op": "create_database", "name": "replica", "file_id": "0000000000000002" },
    { "op": "read_committed", "start": 0, "end": 62, "as": "new_database", "note": "a new database, as of its first commit" },
    { "op": "write", "on": "root", "data": { "uint": 1 } },
    { "op": "read_committed", "start": 0, "end": 96, "as": "first" },
    { "op": "use", "name": "replica" },
    { "op": "apply_replicated", "start": 0, "bytes": "first", "note": "up from 62" },
    { "op": "committed_size", "expect": 96 },
    { "op": "read_committed", "start": 0, "end": 96, "as": "got", "expect_same": "first", "note": "the expected file only says how it ends up, and this says how each sync leaves it" },

    { "op": "use", "name": "main" },
    { "op": "write", "on": "root", "data": { "uint": 2 } },
    { "op": "read_committed", "start": 96, "end": 130, "as": "second" },
    { "op": "use", "name": "replica" },
    { "op": "apply_replicated", "start": 96, "bytes": "second", "short_by": 1, "expect_error": "InvalidDatabase", "note": "the bytes have to end with a trailer" },
    { "op": "committed_size", "expect": 96, "note": "so it's as it was, and what it did write is past the end of what's committed" },
    { "op": "read_uint", "on": "root", "expect": 1 },
    { "op": "replica_state", "as": "state" },
    { "op": "apply_replicated", "start": 96, "bytes": "second", "note": "and the next one writes over that" },
    { "op": "committed_size", "expect": 130 },
    { "op": "read_uint", "on": "root", "expect": 2 },
    { "op": "read_committed", "start": 0, "end": 130, "as": "got" },

    { "op": "use", "name": "main" },
    { "op": "read_committed", "start": 0, "end": 130, "as": "from_main", "expect_same": "got" },
    { "op": "write", "on": "root", "data": { "uint": 3 } },
    { "op": "read_committed", "start": 130, "end": 164, "as": "third" },
    { "op": "use", "name": "replica" },
    { "op": "apply_replicated", "start": 96, "bytes": "third", "expect_error": "InvalidRange", "note": "it has to be at 0, or where its committed bytes end" },
    { "op": "apply_replicated", "start": 140, "bytes": "third", "expect_error": "InvalidRange" },
    { "op": "committed_size", "expect": 130 },
    { "op": "apply_replicated", "start": 130, "bytes": "third", "short_by": 34, "note": "nothing at all, which is fine" },
    { "op": "committed_size", "expect": 130 },
    { "op": "apply_replicated", "start": 130, "bytes": "third" },
    { "op": "committed_size", "expect": 164 },
    { "op": "read_committed", "start": 0, "end": 164, "as": "got" },

    { "op": "use", "name": "main" },
    { "op": "read_committed", "start": 0, "end": 164, "as": "from_main", "expect_same": "got" },
    { "op": "read_committed", "start": 100, "end": 96, "as": "bad", "expect_error": "InvalidRange" },
    { "op": "read_committed", "start": 164, "end": 165, "as": "bad", "expect_error": "InvalidRange", "note": "past what's committed" },
    { "op": "read_committed", "start": 0, "end": 165, "as": "bad", "expect_error": "InvalidRange" },
    { "op": "read_committed", "start": 20, "end": 164, "as": "bad", "expect_error": "InvalidRange", "note": "only 0 or after the root header" },
    { "op": "read_committed", "start": 36, "end": 164, "as": "bad", "expect_error": "InvalidRange" },
    { "op": "read_committed", "start": 37, "end": 62, "as": "fine", "note": "that's right after it" },
    { "op": "read_committed", "start": 164, "end": 164, "as": "fine", "note": "and nothing is fine" },
    { "op": "read_committed", "start": 0, "end": 70, "as": "bad", "expect_error": "InvalidDatabase", "note": "from 0, it has to end at a trailer, to make the root header" },
    { "op": "read_committed", "start": 0, "end": 10, "as": "bad", "expect_error": "InvalidDatabase", "note": "which it can't, with fewer bytes than a trailer has" },

    { "op": "create_database", "name": "as_of_then", "file_id": "0000000000000003" },
    { "op": "read_committed", "start": 0, "end": 96, "as": "earlier" },
    { "op": "use", "name": "as_of_then" },
    { "op": "apply_replicated", "start": 0, "bytes": "earlier", "note": "with a root header for 96, though main's says 164" },
    { "op": "committed_size", "expect": 96 },
    { "op": "read_uint", "on": "root", "expect": 1 },
    { "op": "read_committed", "start": 0, "end": 96, "as": "got", "expect_same": "earlier" },
    { "op": "replica_state", "as": "state" },
    { "op": "use", "name": "main" },
    { "op": "replication_start", "state": "state", "as": "start", "expect": 96, "note": "and it can catch up from there" },
    { "op": "read_committed", "start": 96, "end": 164, "as": "rest" },
    { "op": "use", "name": "as_of_then" },
    { "op": "apply_replicated", "start": 96, "bytes": "rest", "note": "two commits in one go" },
    { "op": "read_uint", "on": "root", "expect": 3 },
    { "op": "read_committed", "start": 0, "end": 164, "as": "got", "expect_same": "from_main" },

    { "op": "create_database", "name": "shorter", "file_id": "0000000000000004" },
    { "op": "use", "name": "shorter" },
    { "op": "write", "on": "root", "data": { "uint": 9 } },
    { "op": "committed_size", "as": "shorter_end", "expect": 96 },
    { "op": "read_committed", "start": 0, "end": { "var": "shorter_end" }, "as": "from_shorter" },
    { "op": "use", "name": "replica" },
    { "op": "replica_state", "as": "ahead" },
    { "op": "committed_size", "expect": 164 },
    { "op": "use", "name": "shorter" },
    { "op": "replication_start", "state": "ahead", "expect": 0, "note": "the replica is further along than this" },
    { "op": "use", "name": "replica" },
    { "op": "apply_replicated", "start": 0, "bytes": "from_shorter", "note": "so its committed size goes down, from 164 to 96, and it isn't a commit" },
    { "op": "committed_size", "expect": 96 },
    { "op": "read_uint", "on": "root", "expect": 9 },
    { "op": "read_committed", "start": 0, "end": 96, "as": "got", "expect_same": "from_shorter" },
    { "op": "write", "on": "root", "data": { "uint": 10 }, "note": "and it's a database like any other, so it can have commits of its own" },
    { "op": "committed_size", "expect": 130 },
    { "op": "replica_state", "as": "diverged" },
    { "op": "use", "name": "shorter" },
    { "op": "replication_start", "state": "diverged", "expect": 0, "note": "after which it isn't a replica of this any more" },

    { "op": "use", "name": "replica" },
    { "op": "apply_replicated", "start": 0, "bytes": "new_database", "note": "and it can go back to nothing" },
    { "op": "committed_size", "expect": 62 },
    { "op": "slot", "on": "root", "expect": { "tag": "none", "full": false } },
    { "op": "read_committed", "start": 0, "end": 62, "as": "got", "expect_same": "new_database" },

    { "op": "create_database", "name": "cleared", "file_id": "0000000000000005" },
    { "op": "use", "name": "cleared" },
    { "op": "apply_replicated", "start": 0, "bytes": "first" },
    { "op": "apply_replicated", "start": 96, "bytes": "second", "short_by": 1, "expect_error": "InvalidDatabase", "note": "this leaves 33 bytes behind" },
    { "op": "apply_replicated", "start": 96, "bytes": "second", "short_by": 34, "note": "and this clears them, with nothing to put there, so its expected file ends at 96" },
    { "op": "committed_size", "expect": 96 }
  ]
}
