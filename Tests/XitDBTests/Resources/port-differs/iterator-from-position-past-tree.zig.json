{
  "format": "xitdb-script/1",
  "description": "An iterator from a position that's below its collection's size and that its tree doesn't have, which only a clone with a header that disagrees with its tree has: a read at that position raises InvalidBTreeNode. The original starts the iterator there anyway, without checking the index it lands on in the leaf (lib.zig:3731). On a clone whose header is above its tree it gives nothing, and panics when the last leaf is fuller. On one whose root counts more than a leaf holds, it gives what comes after that leaf.",
  "hash_size": 20,
  "hash_id": "sha1",
  "file_id": "c0f00000000000c1",
  "ops": [
    {"op": "close"},
    {"op": "raw_load", "input": "sorted-header-above-tree", "note": "a clone whose header says 41 over a tree of 31"},
    {"op": "reopen"},
    {"op": "read_path", "on": "root", "path": [{"array_list_get": 0}, {"hash_map_get": {"value": {"sha1": "map clone"}}}], "as": "c"},
    {"op": "count", "on": "c", "expect": 41},
    {"op": "read_path", "on": "c", "path": [{"sorted_map_get_index": 31}], "as": "e", "expect_error": "InvalidBTreeNode", "note": "a read at 31 runs out of tree, in both"},
    {"op": "iterator", "on": "c", "from_index": 31, "as": "it", "note": "the original starts there without looking"},
    {"op": "next", "on": "it", "expect_null": true, "note": "and gives nothing, with this layout. With a fuller last leaf the first next panics (tests/undefined/frozen-clone-sorted-iterator-past-tree)"},
    {"op": "create_database", "name": "copy_first", "file_id": "c0f00000000000c3"},
    {"op": "use", "name": "copy_first"},
    {"op": "close"},
    {"op": "raw_load", "input": "sorted-counts-above-leaves", "note": "a clone whose root counts 8 for a leaf that holds 6"},
    {"op": "reopen"},
    {"op": "read_path", "on": "root", "path": [{"array_list_get": 0}, {"hash_map_get": {"value": {"sha1": "map clone"}}}], "as": "c"},
    {"op": "count", "on": "c", "expect": 41},
    {"op": "read_path", "on": "c", "path": [{"sorted_map_get_index": 14}], "as": "e", "expect_error": "InvalidBTreeNode", "note": "and a read at 14 runs out of its leaf, in both"},
    {"op": "iterator", "on": "c", "from_index": 14, "as": "it"},
    {"op": "next", "on": "it", "as": "e", "note": "and gives what comes after the leaf: k16 and the 18 after it"},
